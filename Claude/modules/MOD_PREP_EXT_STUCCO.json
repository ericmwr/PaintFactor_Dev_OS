{
  "module_id": "MOD_PREP_EXT_STUCCO",
  "name": "Exterior Stucco/EIFS Surface Preparation",
  "phase": "prep",
  "intent": "Stucco-specific prep: crack assess, EIFS knock test, cure verify, moisture test, wash (substrate-branched), mildew, efflorescence, crack patch, surface patch, caulk, EIFS insurance.",
  "tasks": [
    {
      "task_ref": "TSK_STCO_CRACK_ASSESS"
    },
    {
      "task_ref": "TSK_STCO_EIFS_KNOCK_TEST",
      "applies_when": {
        "substrate_type": [
          "EIFS"
        ]
      }
    },
    {
      "task_ref": "TSK_STCO_CURE_VERIFY",
      "applies_when": {
        "substrate_type": [
          "traditional_stucco"
        ]
      }
    },
    {
      "task_ref": "TSK_STCO_MOISTURE_TEST"
    },
    {
      "task_ref": "TSK_STCO_EIFS_INSURANCE",
      "applies_when": {
        "substrate_type": [
          "EIFS"
        ]
      }
    },
    {
      "task_ref": "TSK_STCO_PRESSURE_WASH",
      "applies_when": {
        "substrate_type": [
          "traditional_stucco"
        ]
      }
    },
    {
      "task_ref": "TSK_STCO_EIFS_WASH",
      "applies_when": {
        "substrate_type": [
          "EIFS"
        ]
      }
    },
    {
      "task_ref": "TSK_STCO_MILDEW_TREAT",
      "applies_when": {
        "mildew_present": true
      }
    },
    {
      "task_ref": "TSK_STCO_EFFLORESCENCE",
      "applies_when": {
        "substrate_type": [
          "traditional_stucco"
        ],
        "efflorescence_present": true
      }
    },
    {
      "task_ref": "TSK_STCO_CRACK_PATCH"
    },
    {
      "task_ref": "TSK_STCO_SURFACE_PATCH"
    },
    {
      "task_ref": "TSK_STCO_CAULK_JOINTS"
    }
  ],
  "modifier_eligibility": {
    "qt": true,
    "height": true,
    "texture": true,
    "complexity": false,
    "condition": false
  },
  "doctrine": "Stucco prep. Crack assess FIRST — >1/8 inch = hard stop. EIFS knock test for delamination. Traditional stucco: pressure wash 1500-3000 PSI. EIFS: low-pressure <500 PSI only. Cure verify traditional only (30-day standard, 7-day w/ alkali primer). Mildew eradication at 150 SF/hr. Texture profile modifier applies to wash and patch tasks. Cracks >1/8 inch outside scope."
}

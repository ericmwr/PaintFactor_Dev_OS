{
  "spec_family_id": "SF_DRYWALL_WALL_FINISH_NC",
  "version": "0.2.0",
  "status": "draft",
  "review_required": true,

  "sop_modules": [
    {
      "module_id": "MOD_PROTECT_WALLS_FOR_FINISH",
      "name": "Protect for Wall Finish",
      "purpose": "Protect floors, adjacent surfaces, and openings prior to wall finishing.",
      "applies_to": { "environment": ["new_construction_clean", "new_construction_active"] }
    },
    {
      "module_id": "MOD_EDGE_TAPE_STRATEGY",
      "name": "Edge Strategy — Tape Line (Cut-to-Tape)",
      "purpose": "Apply tape, cut wall paint to tape line, and remove tape at correct timing.",
      "applies_to": { "edge_strategy": ["tape_line_cut_to_tape"] }
    },
    {
      "module_id": "MOD_EDGE_FREEHAND_STRATEGY",
      "name": "Edge Strategy — Freehand Cut-in",
      "purpose": "Cut-in edges freehand where tape-line is not required or not practical.",
      "applies_to": { "edge_strategy": ["cut_in_freehand"] }
    },
    {
      "module_id": "MOD_APPLY_WALL_FIELD",
      "name": "Apply Wall Field Coats",
      "purpose": "Apply wall finish coats to field areas using selected method.",
      "applies_to": { "application_method": ["spray_only", "spray_backroll", "roll_only"] }
    },
    {
      "module_id": "MOD_SAND_AND_INSPECT",
      "name": "Sand and Inspect",
      "purpose": "Inspect and sand between coats per quality tier.",
      "applies_to": { "quality_level": ["QL-3", "QL-4", "QL-5"] }
    }
  ],

  "tasks": [
    {
      "task_id": "TSK_PROTECT_WALL_AREA_R1",
      "module_id": "MOD_PROTECT_WALLS_FOR_FINISH",
      "name": "Protect floors and adjacent areas for wall finishing",
      "task_type": "protect",
      "round_number": 1,
      "inputs": ["plastic", "tape", "drop_cloths"],
      "outputs": ["protected_area"],
      "notes": "Active construction increases protection and cleanup burden."
    },

    {
      "task_id": "TSK_TAPE_APPLY_EDGES_R1",
      "module_id": "MOD_EDGE_TAPE_STRATEGY",
      "name": "Apply tape to edges (trim/ceiling as scoped)",
      "task_type": "protect",
      "round_number": 1,
      "inputs": ["tape"],
      "outputs": ["tape_applied_edges"],
      "notes": "LF-based; targets determined by edge_targets."
    },
    {
      "task_id": "TSK_EDGE_CUT_TO_TAPE_COAT_1_R1",
      "module_id": "MOD_EDGE_TAPE_STRATEGY",
      "name": "Cut wall paint to tape line — coat 1",
      "task_type": "finish",
      "round_number": 1,
      "inputs": ["finish_paint", "brush"],
      "outputs": ["edge_line_coat_1_complete"]
    },
    {
      "task_id": "TSK_EDGE_CUT_TO_TAPE_COAT_2_R3",
      "module_id": "MOD_EDGE_TAPE_STRATEGY",
      "name": "Cut wall paint to tape line — coat 2",
      "task_type": "finish",
      "round_number": 3,
      "inputs": ["finish_paint", "brush"],
      "outputs": ["edge_line_coat_2_complete"]
    },
    {
      "task_id": "TSK_TAPE_REMOVE_R4",
      "module_id": "MOD_EDGE_TAPE_STRATEGY",
      "name": "Remove tape at correct timing",
      "task_type": "protect",
      "round_number": 4,
      "inputs": ["blade_optional"],
      "outputs": ["tape_removed_clean_lines"],
      "notes": "LF-based; timing is critical to reduce tearing."
    },

    {
      "task_id": "TSK_EDGE_FREEHAND_CUTIN_COAT_1_R1",
      "module_id": "MOD_EDGE_FREEHAND_STRATEGY",
      "name": "Freehand cut-in edges — coat 1",
      "task_type": "finish",
      "round_number": 1,
      "inputs": ["finish_paint", "brush"],
      "outputs": ["freehand_edge_coat_1_complete"]
    },
    {
      "task_id": "TSK_EDGE_FREEHAND_CUTIN_COAT_2_R3",
      "module_id": "MOD_EDGE_FREEHAND_STRATEGY",
      "name": "Freehand cut-in edges — coat 2",
      "task_type": "finish",
      "round_number": 3,
      "inputs": ["finish_paint", "brush"],
      "outputs": ["freehand_edge_coat_2_complete"]
    },

    {
      "task_id": "TSK_APPLY_WALL_FIELD_COAT_1_R1",
      "module_id": "MOD_APPLY_WALL_FIELD",
      "name": "Apply wall field coat 1",
      "task_type": "finish",
      "round_number": 1,
      "inputs": ["finish_paint", "tools_by_method"],
      "outputs": ["field_coat_1_applied"],
      "notes": "SF-based."
    },
    {
      "task_id": "TSK_SAND_BETWEEN_COATS_R2",
      "module_id": "MOD_SAND_AND_INSPECT",
      "name": "Sand between coats (as required)",
      "task_type": "prep",
      "round_number": 2,
      "inputs": ["abrasives"],
      "outputs": ["surface_smoothed"]
    },
    {
      "task_id": "TSK_APPLY_WALL_FIELD_COAT_2_R3",
      "module_id": "MOD_APPLY_WALL_FIELD",
      "name": "Apply wall field coat 2",
      "task_type": "finish",
      "round_number": 3,
      "inputs": ["finish_paint", "tools_by_method"],
      "outputs": ["field_coat_2_applied"],
      "notes": "SF-based."
    },
    {
      "task_id": "TSK_FINAL_WALL_INSPECTION_R4",
      "module_id": "MOD_SAND_AND_INSPECT",
      "name": "Final wall inspection",
      "task_type": "inspect",
      "round_number": 4,
      "inputs": ["lighting"],
      "outputs": ["walls_approved"]
    }
  ],

  "module_task_map": [
    {
      "module_id": "MOD_PROTECT_WALLS_FOR_FINISH",
      "task_ids": ["TSK_PROTECT_WALL_AREA_R1"]
    },
    {
      "module_id": "MOD_EDGE_TAPE_STRATEGY",
      "task_ids": [
        "TSK_TAPE_APPLY_EDGES_R1",
        "TSK_EDGE_CUT_TO_TAPE_COAT_1_R1",
        "TSK_EDGE_CUT_TO_TAPE_COAT_2_R3",
        "TSK_TAPE_REMOVE_R4"
      ]
    },
    {
      "module_id": "MOD_EDGE_FREEHAND_STRATEGY",
      "task_ids": [
        "TSK_EDGE_FREEHAND_CUTIN_COAT_1_R1",
        "TSK_EDGE_FREEHAND_CUTIN_COAT_2_R3"
      ]
    },
    {
      "module_id": "MOD_APPLY_WALL_FIELD",
      "task_ids": [
        "TSK_APPLY_WALL_FIELD_COAT_1_R1",
        "TSK_APPLY_WALL_FIELD_COAT_2_R3"
      ]
    },
    {
      "module_id": "MOD_SAND_AND_INSPECT",
      "task_ids": [
        "TSK_SAND_BETWEEN_COATS_R2",
        "TSK_FINAL_WALL_INSPECTION_R4"
      ]
    }
  ],

  "assumptions": [
    "Edge tasks use LF; field tasks use SF; edge targets are provided by PaintScope-derived scope."
  ],
  "exclusions": [
    "Wall priming and ceiling finishing workflows."
  ]
}

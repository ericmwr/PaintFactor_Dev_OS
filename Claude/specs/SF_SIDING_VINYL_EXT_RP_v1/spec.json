{
  "spec_metadata": {
    "spec_family_id": "SF_SIDING_VINYL_EXT_RP",
    "version": "v1",
    "name": "Vinyl Siding Exterior Repaint",
    "description": "Repaint of existing exterior vinyl (PVC) siding. Single substrate state (SS_EXT_SOUND_PAINT), adhesion primer always required (STIX class), LRV class drives material selection (standard vs IR-reflective). Dramatically simpler than wood siding repaint: no DSD gradient, no RRP gate, no stain-blocking, no backbrushing. QT2-QT3 only — vinyl is not a fine-finish substrate. Spray primary with brush detail at J-channels (QT3). LRV <35 is a hard stop. Painting voids manufacturer warranty — client acknowledgment required.",
    "domain": "exterior",
    "phase_scope": "full",
    "context_prefix": "VNRP",
    "status": "draft",
    "created": "2026-03-10",
    "review_required": true
  },

  "scope_boundaries": {
    "includes": [
      "Warranty void acknowledgment gate (client sign-off before work)",
      "LRV verification gate (color approval against vinyl-safe thresholds)",
      "Pressure wash with alkaline cleaner (mandatory first production step)",
      "Light scuff sand or liquid sander for adhesion tooth on smooth PVC",
      "Post-wash chalk residue test and hand scrub (QT3)",
      "Adhesion primer (STIX class) — full coverage, single coat, always required",
      "Finish coat application (1 coat QT2, 2 coats QT3) — 100% acrylic latex only",
      "J-channel and under-sill brush detail (QT3 only)",
      "Caulk assessment and replacement at siding-to-trim joints (QT3 only)",
      "Landscape and hardscape protection (plastic sheeting, drop cloths)",
      "Window, door, and trim masking for spray operations",
      "Light fixture, HVAC unit, and utility panel masking",
      "Spray equipment setup and cleanup",
      "Final walkthrough inspection and touch-up",
      "Site cleanup and demobilization"
    ],
    "excludes": [
      {
        "item": "Exterior trim painting (corner boards, window/door casing, frieze)",
        "route_to": "Future SF_TRIM_EXT_RP"
      },
      {
        "item": "Soffit and fascia painting",
        "route_to": "Future SF_SOFFIT_EXT_RP"
      },
      {
        "item": "Window and door painting",
        "route_to": "Window/door specs — vinyl siding spec handles spray masking only"
      },
      {
        "item": "Foundation wall coating",
        "route_to": "Future exterior foundation spec"
      },
      {
        "item": "Gutter and downspout painting",
        "route_to": "Future exterior metal/accessory spec"
      },
      {
        "item": "Structurally damaged vinyl panel replacement",
        "route_to": "Siding contractor — SC_SUBSTRATE_DAMAGE is a HARD STOP"
      },
      {
        "item": "Colors below LRV 35",
        "route_to": "Not paintable on vinyl — HARD STOP, no material system available"
      },
      {
        "item": "Aluminum siding repaint",
        "route_to": "Future SF_SIDING_ALUMINUM_EXT_RP — different substrate, different primer chemistry"
      }
    ]
  },

  "configuration_dimensions": [
    {
      "dimension_id": "quality_tier",
      "description": "Quality tier controlling coat count, detail work, caulk assessment, and inspection rigor.",
      "values": ["QT2", "QT3"],
      "default": "QT3",
      "notes": "QT2=economy (adhesion prime + single finish coat, no detail, no caulk). QT3=standard (adhesion prime + 2 finish coats, J-channel detail, caulk assessment). QT4/QT5 excluded — vinyl is not a fine-finish substrate."
    },
    {
      "dimension_id": "lrv_class",
      "description": "Light Reflectance Value class driving material selection and color approval gate.",
      "values": ["standard_55+", "ir_reflective_35-55"],
      "default": "standard_55+",
      "notes": "standard_55+ = any 100% acrylic exterior latex. ir_reflective_35-55 = IR-reflective pigment products ONLY (VinylSafe, Colors for Vinyl). LRV <35 = HARD STOP — not a valid configuration option. lrv_class drives material selection only, NOT labor rates."
    },
    {
      "dimension_id": "access_type",
      "description": "Access method per elevation driving height modifier on production rates.",
      "values": ["ground", "ladder", "scaffold", "lift"],
      "default": "ground",
      "notes": "Per-elevation. ground=1.00, ladder=1.35, scaffold=1.60, lift=1.50. Applied as time multiplier via FAC_EXT_ACCESS."
    }
  ],

  "paintable_items": [
    {
      "item_id": "ITM_SIDING_FIELD",
      "name": "Siding Field",
      "unit_of_measure": "SF",
      "counting_rules": "Net paintable siding field area in square feet. Excludes window/door openings, trim boards. Measured per elevation.",
      "notes": "Primary and only paintable item. Reused from SF_WOOD_SIDING_EXT_NC_PAINT, SF_SIDING_FIBERCEMENT_EXT_NC, SF_SIDING_WOOD_EXT_RP. Single substrate state (SS_EXT_SOUND_PAINT) — vinyl always has factory PVC finish intact."
    }
  ],

  "material_systems": [
    {
      "system_id": "SYS_EXT_VNRP_PRIMER_ADHESION",
      "name": "Vinyl Adhesion Primer (STIX Class)",
      "product_role": "primer",
      "quality_tier": ["QT2", "QT3"],
      "allowed_sheens": ["n/a"],
      "applies_when": {
        "condition": "always — adhesion primer is mandatory regardless of vinyl condition"
      },
      "products": [
        "Insl-X STIX Waterborne Bonding Primer (SXA-110)",
        "Benjamin Moore Fresh Start All-Purpose Primer (023)",
        "Sherwin-Williams Extreme Bond Primer"
      ],
      "coverage_sf_per_gallon": 350,
      "coverage_range": [300, 400],
      "coats": 1,
      "notes": "MANDATORY for all vinyl siding repaints. Solvent-attack chemical bond to PVC. Standard exterior primers are NOT acceptable substitutes. Full-surface coverage — no spot priming option."
    },
    {
      "system_id": "SYS_EXT_VNRP_FINISH_STANDARD",
      "name": "Exterior Acrylic Latex — Standard Colors (LRV 55+)",
      "product_role": "finish",
      "quality_tier": ["QT2", "QT3"],
      "allowed_sheens": ["flat", "satin"],
      "applies_when": {
        "lrv_class": ["standard_55+"]
      },
      "products": [
        "Sherwin-Williams Duration Exterior Acrylic Latex",
        "Benjamin Moore Regal Select Exterior",
        "PPG Sun Proof Exterior Latex"
      ],
      "coverage_sf_per_gallon": 400,
      "coverage_range": [350, 450],
      "coats_by_tier": {
        "QT2": 1,
        "QT3": 2
      },
      "notes": "Standard 100% acrylic exterior latex for LRV 55+. Alkyd/oil/hybrid PROHIBITED. QT2 = single coat, QT3 = two coats."
    },
    {
      "system_id": "SYS_EXT_VNRP_FINISH_IR_REFLECTIVE",
      "name": "Exterior IR-Reflective Acrylic — Dark Colors (LRV 35-55)",
      "product_role": "finish",
      "quality_tier": ["QT2", "QT3"],
      "allowed_sheens": ["flat", "satin"],
      "applies_when": {
        "lrv_class": ["ir_reflective_35-55"]
      },
      "products": [
        "Sherwin-Williams VinylSafe Colors (Duration Exterior line)",
        "Benjamin Moore Colors for Vinyl (Regal Select Exterior line)",
        "PPG Timeless Exterior with VinylSafe Technology"
      ],
      "coverage_sf_per_gallon": 325,
      "coverage_range": [300, 350],
      "coats_by_tier": {
        "QT2": 1,
        "QT3": 2
      },
      "notes": "IR-reflective pigment products for LRV 35-55. Prevents thermal distortion on PVC. 15-20% lower coverage than standard acrylic due to heavier pigment load. Higher material cost, identical labor rates."
    }
  ],


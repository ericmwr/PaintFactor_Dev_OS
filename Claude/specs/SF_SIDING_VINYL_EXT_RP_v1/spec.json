  "gate_conditions": [
    {
      "gate_id": "GATE_VNRP_LRV_HARD_STOP",
      "description": "LRV <35 — HARD STOP",
      "condition": "Selected color has LRV below 35",
      "action": "STOP",
      "reason": "No material system available for colors below LRV 35 on vinyl siding. Even IR-reflective pigments cannot prevent thermal distortion at this LRV range. PVC heat deflection temperature (165 deg F) will be exceeded. Damage is irreversible — warped panels require replacement.",
      "enforced_by": "TSK_VNRP_LRV_VERIFY"
    },
    {
      "gate_id": "GATE_VNRP_PHYSICAL_DAMAGE",
      "description": "Physical damage — HARD STOP",
      "condition": "Cracked, warped, broken, or structurally damaged vinyl panels",
      "action": "STOP",
      "reason": "Damaged vinyl panels cannot be painted. PVC damage is structural — painting cannot restore panel integrity. Panels must be replaced by siding contractor before painting scope applies.",
      "enforced_by": "Pre-scope assessment"
    },
    {
      "gate_id": "GATE_VNRP_WARRANTY_VOID",
      "description": "Manufacturer warranty void acknowledgment",
      "condition": "Client has not signed warranty void acknowledgment",
      "action": "STOP",
      "reason": "Painting vinyl siding voids manufacturer finish warranty. Client must acknowledge warranty void and receive contractor workmanship warranty before any work begins.",
      "enforced_by": "TSK_VNRP_WARRANTY_GATE"
    },
    {
      "gate_id": "GATE_VNRP_BINDER_RESTRICTION",
      "description": "100% acrylic latex binder required",
      "condition": "Any non-acrylic binder type specified (alkyd, oil, hybrid)",
      "action": "STOP",
      "reason": "Only 100% acrylic latex binder is permitted on vinyl siding. Alkyd/oil/hybrid coatings crack and delaminate within 12-24 months due to PVC thermal movement.",
      "enforced_by": "Material specification and QC at delivery"
    }
  ],


{
  "spec_family_id": "SF_DRYWALL_WALL_NC_PRIME",
  "version": "0.1.0",

  "material_systems": [
    {
      "system_id": "SYS_PVA_PRIMER",
      "name": "PVA Drywall Primer",
      "description": "Polyvinyl acetate (PVA) primer for bare drywall. Economical, fast-drying, excellent sealing of porous drywall surfaces. Standard choice for new construction.",
      "applies_when": {
        "quality_tier": ["QT2", "QT3"]
      },
      "products": [
        {
          "product_role": "primer",
          "product_type": "PVA drywall primer",
          "example_products": [
            "Kilz PVA Drywall Primer",
            "Zinsser Drywall Primer",
            "Glidden PVA Primer",
            "Sherwin-Williams Drywall Primer"
          ],
          "sheen": "flat",
          "coats_required": 1,
          "notes": "PVA-based primers seal porous drywall, block minor stains, provide good holdout for topcoats. Low VOC, fast dry (1 hour), water cleanup."
        }
      ]
    },
    {
      "system_id": "SYS_ACRYLIC_LATEX_PRIMER",
      "name": "Acrylic Latex Primer",
      "description": "Premium acrylic latex primer for new drywall. Superior adhesion, better hide, excellent topcoat holdout. Recommended for QT4 work.",
      "applies_when": {
        "quality_tier": ["QT4"]
      },
      "products": [
        {
          "product_role": "primer",
          "product_type": "Acrylic latex primer",
          "example_products": [
            "Benjamin Moore Fresh Start 023",
            "Sherwin-Williams ProMar 200 Primer",
            "PPG Speedhide Interior Latex Primer",
            "Behr Premium Plus Primer"
          ],
          "sheen": "flat",
          "coats_required": 1,
          "notes": "Acrylic latex provides better adhesion than PVA, superior stain blocking, and better topcoat compatibility. Slightly longer dry time (2-4 hours)."
        }
      ]
    },
    {
      "system_id": "SYS_HIGH_BUILD_PRIMER",
      "name": "High-Build Drywall Primer",
      "description": "High-build primer for Level 5 finish or when maximum surface uniformity is required. Fills minor imperfections.",
      "applies_when": {
        "quality_tier": ["QT4"],
        "drywall_finish_level": ["level_5"]
      },
      "products": [
        {
          "product_role": "primer",
          "product_type": "High-build drywall primer",
          "example_products": [
            "Sherwin-Williams High Build Drywall Primer/Surfacer",
            "USG Sheetrock Brand Tuff-Hide",
            "Benjamin Moore Ultra Spec 500 Interior High Build Primer"
          ],
          "sheen": "flat",
          "coats_required": 1,
          "notes": "High-build formula fills minor imperfections and provides uniform porosity across joints and field. May require light sand before topcoat."
        }
      ]
    }
  ],


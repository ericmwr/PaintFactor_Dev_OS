  "scope_boundaries": {
    "includes": [
      "Stain application on bare wood railing components (brush+wipe, spray+wipe)",
      "Second stain coat application (optional)",
      "Sanding sealer application (0-2 coats, QT-driven)",
      "Clear topcoat application (1-3 coats, QT-driven)",
      "Bare wood preparation (inspect, sand 120-150 grit, fill, grain raise, tack)",
      "Wood conditioner application (softwood + stain, unless gel stain)",
      "Interstage sanding between sealer and clear coats",
      "Stain dry verification",
      "Handrail staining (LF — all 4 surfaces: top, 2 sides, underside)",
      "Baluster staining (EA — intricate wipe required for turned profiles)",
      "Newel post staining (EA — caps, rosettes, flutes detail)",
      "Baluster-to-handrail junction finishing",
      "Tread protection (mandatory)",
      "Floor protection at landings",
      "Wall masking for stairwell (spray)"
    ],
    "excludes": [
      { "item": "Stair risers", "route_to": "SF_STAIR_RISER_NC or future stain spec" },
      { "item": "Stair treads", "route_to": "SF_STAIR_TREAD_NC (future)" },
      { "item": "Railing paint workflows", "route_to": "SF_STAIR_RAILING_NC" },
      { "item": "Iron/metal balusters", "route_to": "Not applicable for stain — stain is wood-only" },
      { "item": "Exterior railing", "route_to": "Future exterior stain spec" }
    ]
  },


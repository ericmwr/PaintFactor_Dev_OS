{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production.schema.json",
  "title": "PaintFactor Production Logic Schema",
  "type": "object",
  "required": [
    "spec_family_id",
    "version",
    "task_production_rates"
  ],
  "properties": {
    "spec_family_id": { "type": "string", "pattern": "^SF_[A-Z0-9_]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },

    "task_production_rates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "unit_of_measure", "rate_per_hour"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TASK_[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "required_input_key": { "type": "string", "pattern": "^IN_[A-Z0-9_]+$" },
          "paintscope_key": { "type": "string", "pattern": "^PS_[A-Z0-9_.]+$" },
          "unit_of_measure": { "type": "string", "enum": ["EA", "LF", "SF"] },
          "rate_per_hour": { "type": "number", "exclusiveMinimum": 0 },
          "rate_range_low": { "type": "number", "exclusiveMinimum": 0 },
          "rate_range_high": { "type": "number", "exclusiveMinimum": 0 },
          "crew_size": { "type": "integer", "minimum": 1, "maximum": 12 },
          "rate_basis_notes": { "type": "string" },
          "applies_when": { "type": "object" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "factor_modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["factor_id", "name", "description", "modifier_type", "applies_to_tasks"],
        "properties": {
          "factor_id": { "type": "string", "pattern": "^FAC_[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "modifier_type": {
            "type": "string",
            "enum": ["time_multiplier", "additive", "coverage_adjustment"]
          },
          "applies_to_tasks": {
            "type": "array",
            "items": { "type": "string", "pattern": "^TASK_[A-Z0-9_]+$" }
          },
          "value_table": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "value_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          },
          "input_key": { "type": "string", "pattern": "^IN_[A-Z0-9_]+$" },
          "paintscope_key": { "type": "string", "pattern": "^PS_[A-Z0-9_.]+$" },
          "application_rule": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "quality_tier_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quality_tier", "time_modifier", "description", "mechanism"],
        "properties": {
          "quality_tier": {
            "type": "string",
            "enum": ["QT2", "QT3", "QT4", "QT5"]
          },
          "time_modifier": { "type": "number", "exclusiveMinimum": 0 },
          "description": { "type": "string" },
          "mechanism": {
            "type": "string",
            "enum": ["baseline", "selective_multiplier", "additional_rounds"]
          },
          "condition_gate": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "coupling_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraint_id", "description", "rule"],
        "properties": {
          "constraint_id": { "type": "string", "pattern": "^COUPLE_[A-Z0-9_]+$" },
          "description": { "type": "string" },
          "rule": { "type": "string" },
          "applies_when": { "type": "object" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "production_notes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true
}

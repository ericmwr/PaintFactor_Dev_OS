{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production.schema.json",
  "title": "PaintFactor Production Logic Schema",
  "type": "object",
  "required": [
    "spec_family_id",
    "version",
    "task_production_rates"
  ],
  "properties": {
    "spec_family_id": { "type": "string", "pattern": "^SF_[A-Z0-9_]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },

    "task_production_rates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TSK_[A-Z0-9_]+$" },
          "task_class": {
            "type": "string",
            "enum": ["binary", "qt_conditional", "qt_scaled"],
            "description": "Deprecated: use task_classification in sop_modules.json"
          },
          "task_classification": {
            "type": "string",
            "enum": ["binary", "qt_conditional", "qt_scaled"],
            "description": "Must match task_classification in sop_modules.json"
          },
          "name": { "type": "string" },
          "required_input_key": {
            "type": ["string", "null"],
            "pattern": "^(IN_[A-Z0-9_]+|Calculated)$"
          },
          "paintscope_key": {
            "type": ["string", "null"],
            "pattern": "^(PS_[A-Z0-9_.]+|Calculated:.*)$"
          },
          "unit_of_measure": { "type": "string", "enum": ["EA", "LF", "SF", "EA_ROOM", "FIXED", "FIXED_TIME"] },
          "crew_size": { "type": "integer", "minimum": 1, "maximum": 12 },

          "rate_per_hour": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Single rate for binary tasks. Base rate for qt_scaled tasks."
          },
          "rate_range_low": { "type": "number" },
          "rate_range_high": { "type": "number" },

          "qt_rates": {
            "type": "object",
            "description": "For qt_scaled tasks only. Rate per quality tier.",
            "properties": {
              "QT2": { "type": "number" },
              "QT3": { "type": "number" },
              "QT4": { "type": "number" },
              "QT5": { "type": "number" }
            }
          },

          "defect_tolerance": {
            "type": "object",
            "description": "Task-specific defect tolerance by quality tier",
            "properties": {
              "QT2": { "type": "string" },
              "QT3": { "type": "string" },
              "QT4": { "type": "string" },
              "QT5": { "type": "string" }
            }
          },

          "appears_in_tiers": {
            "type": "array",
            "items": { "type": "string", "enum": ["QT2", "QT3", "QT4", "QT5"] },
            "description": "For qt_conditional tasks only. Which tiers include this task."
          },

          "rate_basis_notes": { "type": "string" },
          "applies_when": { "type": "object" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "factor_modifiers": {
      "oneOf": [
        {
          "type": "array",
          "description": "Array format for factor modifiers",
          "items": {
            "type": "object",
            "required": ["factor_id", "name", "description", "modifier_type", "applies_to_tasks"],
            "properties": {
              "factor_id": { "type": "string", "pattern": "^FAC_[A-Z0-9_]+$" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "modifier_type": {
                "type": "string",
                "enum": ["time_multiplier", "additive", "coverage_adjustment"]
              },
              "applies_to_tasks": {
                "type": "array",
                "items": { "type": "string", "pattern": "^TSK_[A-Z0-9_]+$" }
              },
              "value_table": {
                "type": "object",
                "additionalProperties": { "type": "number" }
              },
              "value_range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              },
              "input_key": { "type": "string", "pattern": "^IN_[A-Z0-9_]+$" },
              "paintscope_key": { "type": "string", "pattern": "^PS_[A-Z0-9_.]+$" },
              "application_rule": { "type": "string" },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        {
          "type": "object",
          "description": "Object format with named modifier categories (height, complexity, color_change, texture)",
          "additionalProperties": true
        }
      ]
    },

    "quality_tier_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quality_tier", "description", "mechanism"],
        "properties": {
          "quality_tier": {
            "type": "string",
            "pattern": "^QT[2-5](_[A-Z]+)?$",
            "description": "Quality tier, optionally with suffix like QT4_FLAT"
          },
          "time_modifier": { "type": "number", "exclusiveMinimum": 0 },
          "description": { "type": "string" },
          "mechanism": {
            "type": "string",
            "enum": ["baseline", "baseline_reduction", "selective_multiplier", "additional_rounds", "qt_scaled_rates"]
          },
          "condition_gate": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "coupling_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraint_id", "description", "rule"],
        "properties": {
          "constraint_id": { "type": "string", "pattern": "^COUPLE_[A-Z0-9_]+$" },
          "description": { "type": "string" },
          "rule": { "type": "string" },
          "applies_when": { "type": "object" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "production_notes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true
}

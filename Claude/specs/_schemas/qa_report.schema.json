{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa_report.schema.json",
  "title": "PaintFactor QA Report Schema",
  "type": "object",
  "required": ["spec_family_id", "version", "reviewed_by", "status", "issues", "summary", "review_notes"],
  "properties": {
    "spec_family_id": { "type": "string", "pattern": "^SF_[A-Z0-9_]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "reviewed_by": { "type": "string" },
    "status": { "type": "string", "enum": ["pass", "pass_with_warnings", "fail"] },

    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "area", "description", "suggested_fix", "recommended_agent"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
          "area": {
            "type": "string",
            "enum": [
              "schema_alignment",
              "materials_logic",
              "sop_modularity",
              "production_logic",
              "quality_rounds",
              "assumptions",
              "other"
            ]
          },
          "description": { "type": "string" },
          "suggested_fix": { "type": "string" },
          "recommended_agent": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "summary": { "type": "string" },
    "review_notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sop_modules.schema.json",
  "title": "PaintFactor SOP Modules Schema",
  "type": "object",
  "required": [
    "spec_family_id",
    "version",
    "sop_modules"
  ],
  "properties": {
    "spec_family_id": { "type": "string", "pattern": "^SF_[A-Z0-9_]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },

    "sop_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module_id", "name", "description", "phase", "applies_when", "tasks"],
        "properties": {
          "module_id": { "type": "string", "pattern": "^SOP_[A-Z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "phase": {
            "type": "string",
            "enum": ["prep", "protect", "apply", "cleanup", "prime", "finish", "inspect", "repair"]
          },
          "applies_when": { "type": "object" },
          "required_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["input_name", "uom"],
              "properties": {
                "input_name": { "type": "string", "pattern": "^IN_[A-Z0-9_]+$" },
                "paintscope_key": { "type": "string", "pattern": "^PS_[A-Z0-9_.]+$" },
                "uom": { "type": "string", "enum": ["SF", "LF", "EA", "ENUM", "BOOL"] },
                "required_when": { "type": "object" }
              }
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["task_id", "name", "description"],
              "properties": {
                "task_id": { "type": "string", "pattern": "^TASK_[A-Z0-9_]+$" },
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "skill_level": {
                  "type": "string",
                  "enum": ["helper", "journeyman", "lead"]
                },
                "tools_required": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "applies_when": { "type": "object" },
                "critical_constraints": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "quality_notes": {
                  "type": "object",
                  "properties": {
                    "QT2": { "type": "string" },
                    "QT3": { "type": "string" },
                    "QT4": { "type": "string" },
                    "QT5": { "type": "string" }
                  },
                  "additionalProperties": false
                },
                "notes": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "sequence_notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "round_configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round_id", "name", "description", "applies_when", "phase_sequence"],
        "properties": {
          "round_id": { "type": "string", "pattern": "^ROUND_[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "applies_when": { "type": "object" },
          "phase_sequence": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["prep", "protect", "apply", "cleanup", "prime", "finish", "inspect", "repair"]
            }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "module_notes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true
}

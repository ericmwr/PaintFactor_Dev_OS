{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sop_modules.schema.json",
  "title": "PaintFactor SOP Modules Schema",
  "type": "object",
  "required": [
    "spec_family_id",
    "version",
    "sop_modules"
  ],
  "properties": {
    "spec_family_id": { "type": "string", "pattern": "^SF_[A-Z0-9_]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },

    "sop_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module_id", "name", "description", "phase", "applies_when", "tasks"],
        "properties": {
          "module_id": { "type": "string", "pattern": "^(SOP_|MOD_)[A-Z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "phase": {
            "type": "string",
            "enum": ["setup", "prep", "prime", "apply", "interstage", "finish", "cleanup", "inspect", "repair", "final"]
          },
          "applies_when": { "type": "object" },
          "required_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["input_name", "uom"],
              "properties": {
                "input_name": { "type": "string", "pattern": "^IN_[A-Z0-9_]+$" },
                "paintscope_key": { "type": "string", "pattern": "^PS_[A-Z0-9_.]+$" },
                "uom": { "type": "string", "enum": ["SF", "LF", "EA", "ENUM", "BOOL"] },
                "required_when": {
                  "oneOf": [
                    { "type": "object" },
                    { "type": "string" }
                  ]
                }
              }
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["task_id", "name", "description"],
              "properties": {
                "task_id": { "type": "string", "pattern": "^TSK_[A-Z0-9_]+$" },
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "task_classification": {
                  "type": "string",
                  "enum": ["binary", "qt_conditional", "qt_scaled"],
                  "description": "binary = pass/fail, same all tiers; qt_conditional = appears only in specified tiers; qt_scaled = all tiers but rate varies"
                },
                "qt_behavior": {
                  "type": "string",
                  "description": "For binary: 'all_tiers_identical'. For qt_conditional: tier list like 'QT4_QT5_only'. For qt_scaled: 'rate_varies_by_tier'."
                },
                "method_variant_of": {
                  "type": ["string", "null"],
                  "description": "If this task is one method option among alternatives (e.g., spray vs roll), name the variant group"
                },
                "skill_level": {
                  "type": "string",
                  "enum": ["helper", "journeyman", "lead"]
                },
                "tools_required": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "applies_when": { "type": "object" },
                "critical_constraints": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "quality_notes": {
                  "type": "object",
                  "properties": {
                    "QT2": { "type": "string" },
                    "QT3": { "type": "string" },
                    "QT4": { "type": "string" },
                    "QT5": { "type": "string" },
                    "all": { "type": "string", "description": "Notes that apply to all quality tiers" }
                  },
                  "additionalProperties": true
                },
                "notes": { "type": "string" },
                "site_condition_rules": {
                  "type": "object",
                  "description": "Declares site conditions affecting task inclusion (Spec_Completeness_Doctrine Layer 3)",
                  "properties": {
                    "include_when": {
                      "type": "object",
                      "description": "Condition ID → array of values that trigger task inclusion"
                    },
                    "exclude_when": {
                      "type": "object",
                      "description": "Condition ID → array of values that trigger task exclusion"
                    }
                  },
                  "additionalProperties": false
                },
                "modifier_when_included": {
                  "type": "object",
                  "description": "Condition-specific modifier values applied when task is included. Values must align with Modifier_Registry.md."
                },
                "protection_metadata": {
                  "type": "object",
                  "description": "Metadata for protection tasks enabling project-level optimization",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": ["setup", "teardown", "maintain"],
                      "description": "Whether this task sets up, tears down, or maintains protection"
                    },
                    "zones": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z_]+$"
                      },
                      "description": "Protection zone IDs this task affects"
                    },
                    "protection_level": {
                      "type": "string",
                      "enum": ["edge_only", "partial_cover", "full_cover"],
                      "description": "Level of protection this task provides"
                    },
                    "method_dependent": {
                      "type": "boolean",
                      "default": false,
                      "description": "If true, zone requirements vary by application method"
                    }
                  },
                  "required": ["action", "zones"]
                },
                "adjacency_metadata": {
                  "type": "object",
                  "description": "Defines task behavior based on adjacent surface finish relationships",
                  "properties": {
                    "adjacent_surface": {
                      "type": "string",
                      "description": "Surface ID this task relates to (from surface vocabulary)"
                    },
                    "condition": {
                      "type": "string",
                      "enum": ["different_finish", "same_finish", "always"],
                      "description": "The finish relationship condition this task is designed for"
                    },
                    "skip_when": {
                      "type": "string",
                      "enum": ["same_finish_group", "different_finish_group"],
                      "description": "Condition under which engine should skip this task"
                    },
                    "required_when": {
                      "type": "string",
                      "enum": ["same_finish_group", "different_finish_group"],
                      "description": "Condition under which this task is mandatory"
                    },
                    "rate_modifier_category": {
                      "type": "string",
                      "enum": ["edge_masking", "cut_in", "spray_edge", "inspection"],
                      "description": "Category for applying continuity rate modifiers"
                    },
                    "application_method": {
                      "type": "string",
                      "enum": ["brush_roll", "spray", "any"],
                      "default": "any",
                      "description": "Restricts when this task applies based on method"
                    }
                  },
                  "required": ["adjacent_surface"]
                }
              },
              "additionalProperties": true
            }
          },
          "sequence_notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "round_configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round_id", "name", "description", "applies_when", "phase_sequence"],
        "properties": {
          "round_id": { "type": "string", "pattern": "^ROUND_[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "applies_when": { "type": "object" },
          "phase_sequence": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Standard phases: setup, prep, prime, apply, interstage, finish, cleanup, inspect, repair, final. Custom phases allowed for round-specific sequences."
            }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "module_notes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research.schema.json",
  "title": "PaintFactor Research Output Schema",
  "type": "object",
  "required": [
    "spec_family_id",
    "version",
    "relevant_findings",
    "condition_drivers",
    "quality_differences",
    "failure_modes",
    "required_paintscope_keys",
    "notes_for_materials_manager",
    "notes_for_sop_librarian",
    "notes_for_estimation_engineer",
    "assumptions",
    "uncertainties",
    "confidence_level"
  ],
  "properties": {
    "spec_family_id": { "type": "string", "pattern": "^SF_[A-Z0-9_]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },

    "scope_summary": { "type": "string" },

    "relevant_findings": { "type": "array", "items": { "type": "string" } },
    "condition_drivers": { "type": "array", "items": { "type": "string" } },
    "quality_differences": { "type": "array", "items": { "type": "string" } },
    "failure_modes": { "type": "array", "items": { "type": "string" } },

    "required_paintscope_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "description", "uom"],
        "properties": {
          "key": { "type": "string", "pattern": "^PS_[A-Z0-9_.]+$" },
          "description": { "type": "string" },
          "uom": { "type": "string", "enum": ["SF", "LF", "EA", "ENUM", "BOOL"] },
          "required": { "type": "boolean" },
          "required_when": { "type": "object" }
        },
        "additionalProperties": true
      }
    },

    "proposed_new_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposed_key", "rationale", "uom", "priority"],
        "properties": {
          "proposed_key": { "type": "string", "pattern": "^PS_[A-Z0-9_.]+$" },
          "rationale": { "type": "string" },
          "uom": { "type": "string", "enum": ["SF", "LF", "EA", "ENUM", "BOOL"] },
          "priority": { "type": "string", "enum": ["required", "recommended", "optional"] }
        },
        "additionalProperties": true
      }
    },

    "adjacency_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_type", "scope_impact"],
        "properties": {
          "edge_type": { "type": "string" },
          "scope_impact": { "type": "string" },
          "paintscope_key": { "type": "string", "pattern": "^PS_[A-Z0-9_.]+$" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "notes_for_materials_manager": { "type": "array", "items": { "type": "string" } },
    "notes_for_sop_librarian": { "type": "array", "items": { "type": "string" } },
    "notes_for_estimation_engineer": { "type": "array", "items": { "type": "string" } },

    "assumptions": { "type": "array", "items": { "type": "string" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "confidence_level": { "type": "string", "enum": ["low", "medium", "high"] }
  },
  "additionalProperties": true
}

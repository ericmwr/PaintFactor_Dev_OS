{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec.schema.json",
  "title": "PaintFactor Spec Family Schema",
  "type": "object",
  "required": [
    "spec_family",
    "configuration_dimensions",
    "paintable_items",
    "variants",
    "required_paintscope_inputs",
    "dependencies",
    "change_log",
    "protection_zones_required",
    "adjacency_declarations",
    "state_declarations"
  ],
  "properties": {
    "spec_family": {
      "type": "object",
      "required": ["id", "name", "description", "domain", "version", "status", "review_required"],
      "properties": {
        "id": { "type": "string", "pattern": "^SF_[A-Z0-9_]+$" },
        "name": { "type": "string", "minLength": 3 },
        "description": { "type": "string" },
        "domain": { "type": "string", "enum": ["interior", "exterior", "specialty"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "type": "string", "enum": ["draft", "review_required", "approved", "deprecated"] },
        "review_required": { "type": "boolean" }
      },
      "additionalProperties": true
    },

    "configuration_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension_id", "description", "values"],
        "properties": {
          "dimension_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "description": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": true
      }
    },

    "paintable_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "name", "unit_of_measure", "counting_rules"],
        "properties": {
          "item_id": { "type": "string", "pattern": "^ITM_[A-Z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "unit_of_measure": { "type": "string", "enum": ["EA", "LF", "SF"] },
          "counting_rules": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variant_id", "applies_when", "included_items"],
        "properties": {
          "variant_id": { "type": "string", "pattern": "^VAR_[A-Z0-9_]+$" },
          "applies_when": { "type": "object" },
          "included_items": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ITM_[A-Z0-9_]+$" }
          },
          "excluded_items": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ITM_[A-Z0-9_]+$" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "required_paintscope_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input_name", "paintscope_key", "uom"],
        "properties": {
          "input_name": { "type": "string", "pattern": "^IN_[A-Z0-9_]+$" },
          "paintscope_key": { "type": "string", "pattern": "^PS_[A-Z0-9_.]+$" },
          "uom": { "type": "string", "enum": ["SF", "LF", "EA", "ENUM", "BOOL"] },
          "required": { "type": "boolean" },
          "required_when": { "type": "object" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "dependencies": {
      "type": "object",
      "required": ["materials", "sop_modules", "production"],
      "properties": {
        "materials": { "type": "string" },
        "sop_modules": { "type": "string" },
        "production": { "type": "string" },
        "research": { "type": "string" }
      },
      "additionalProperties": false
    },

    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "date", "author"],
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string" },
          "author": { "type": "string" },
          "summary": { "type": "string", "description": "Deprecated: use changes instead" },
          "changes": { "type": "string", "description": "Description of changes in this version" }
        },
        "additionalProperties": true
      }
    },

    "doctrine_overrides": {
      "type": "array",
      "description": "Log of human decisions when research contradicted doctrine",
      "items": {
        "type": "object",
        "required": ["override_id", "conflict_id", "doctrine_source", "resolution", "rationale", "decided_by", "applied_value"],
        "properties": {
          "override_id": {
            "type": "string",
            "pattern": "^DO-[0-9]{3}$"
          },
          "conflict_id": {
            "type": "string",
            "pattern": "^DC-[0-9]{3}$"
          },
          "detected_by": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "doctrine_source": {
            "type": "string"
          },
          "doctrine_value": {
            "type": "string"
          },
          "research_source": {
            "type": "string"
          },
          "research_value": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "enum": ["use_doctrine", "use_research", "use_research_update_doctrine"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "decided_by": {
            "type": "string"
          },
          "applied_value": {
            "type": "string"
          },
          "doctrine_update_required": {
            "type": "boolean"
          },
          "doctrine_update_task": {
            "type": "object",
            "properties": {
              "task_id": { "type": "string", "pattern": "^DU-[0-9]{3}$" },
              "target_doc": { "type": "string" },
              "target_section": { "type": "string" },
              "proposed_change": { "type": "string" },
              "status": { "type": "string", "enum": ["pending", "complete"] }
            }
          }
        }
      }
    },

    "research_corrections": {
      "type": "array",
      "description": "Log of human corrections to research-derived values",
      "items": {
        "type": "object",
        "required": ["correction_id", "original_claim", "corrected_to", "rationale", "corrected_by", "doctrine_target"],
        "properties": {
          "correction_id": {
            "type": "string",
            "pattern": "^RC-[0-9]{3}$"
          },
          "agent": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "original_claim": {
            "type": "string"
          },
          "original_source": {
            "type": "string"
          },
          "corrected_to": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "corrected_by": {
            "type": "string"
          },
          "doctrine_target": {
            "type": "string"
          },
          "is_new_doctrine": {
            "type": "boolean"
          },
          "doctrine_update_status": {
            "type": "string",
            "enum": ["pending", "complete"]
          }
        }
      }
    },

    "protection_zones_required": {
      "type": "array",
      "description": "Declares protection zones this spec activates (Spec_Completeness_Doctrine Layer 1)",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["zone_id", "condition", "protection_level"],
        "properties": {
          "zone_id": {
            "type": "string",
            "description": "Zone ID from Protection_Zones_Reference.md"
          },
          "condition": {
            "oneOf": [
              { "const": "always" },
              { "type": "object" }
            ],
            "description": "'always' or object with dimension/condition filters"
          },
          "protection_level": {
            "type": "string",
            "enum": ["edge_only", "partial_cover", "full_cover"],
            "description": "Level of protection required"
          },
          "upgrades_to_zone": {
            "type": "string",
            "description": "Zone ID to upgrade to under certain conditions"
          },
          "upgrades_to_level": {
            "type": "string",
            "enum": ["edge_only", "partial_cover", "full_cover"],
            "description": "Protection level to upgrade to"
          },
          "upgrade_condition": {
            "type": "object",
            "description": "Conditions triggering the upgrade"
          }
        },
        "additionalProperties": false
      }
    },

    "adjacency_declarations": {
      "type": "object",
      "description": "Declares primary surface and adjacent surfaces for finish continuity optimization (Spec_Completeness_Doctrine Layer 2)",
      "required": ["primary_surface", "adjacent_surfaces"],
      "properties": {
        "primary_surface": {
          "type": "string",
          "description": "Surface ID for the main substrate this spec addresses"
        },
        "adjacent_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["surface_id", "edge_type", "typical_relationship", "affected_tasks"],
            "properties": {
              "surface_id": {
                "type": "string",
                "description": "Surface ID from Surface_Vocabulary_Reference.md"
              },
              "edge_type": {
                "type": "string",
                "enum": ["linear", "complex"],
                "description": "linear = surfaces meet along a line; complex = interconnected system"
              },
              "typical_relationship": {
                "type": "string",
                "enum": ["same_finish", "different_finish", "varies", "not_in_scope"],
                "default": "varies",
                "description": "Default finish relationship assumption"
              },
              "continuity_rate_modifier": {
                "type": "number",
                "minimum": 1.0,
                "maximum": 2.0,
                "description": "Rate improvement factor when finishes are continuous (1.0-2.0)"
              },
              "affected_tasks": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 0,
                "description": "Task IDs in sop_modules.json affected by this adjacency"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },

    "state_declarations": {
      "type": "object",
      "description": "Declares substrate state requirements and transitions for engine validation and protection resolution",
      "required": ["primary_surface", "valid_input_states", "output_state"],
      "properties": {
        "primary_surface": {
          "type": "string",
          "description": "Surface ID from Surface_Vocabulary_Reference.md"
        },
        "valid_input_states": {
          "type": "object",
          "description": "What substrate states can this spec operate on",
          "required": ["states"],
          "properties": {
            "states": {
              "type": "array",
              "items": { "type": "string", "pattern": "^SS_" },
              "minItems": 1,
              "description": "Valid SS_* state IDs from Substrate_State_Reference.md"
            },
            "notes": { "type": "string" }
          }
        },
        "output_state": {
          "type": "object",
          "description": "What state does executing this spec leave the surface in",
          "required": ["state"],
          "properties": {
            "state": {
              "type": "string",
              "pattern": "^SS_",
              "description": "Output SS_* state ID"
            },
            "varies_by": {
              "type": ["string", "null"],
              "description": "Configuration dimension that affects output state (e.g., 'sheen'), or null if output state is fixed"
            },
            "state_map": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^SS_" },
              "description": "Maps config values to output states when varies_by is set"
            },
            "notes": { "type": "string" }
          }
        },
        "adjacent_state_protection_rules": {
          "type": "array",
          "description": "Protection requirements based on adjacent surface states",
          "items": {
            "type": "object",
            "required": ["adjacent_surface", "when_state", "protection_level"],
            "properties": {
              "adjacent_surface": {
                "type": "string",
                "description": "Surface ID from Surface_Vocabulary_Reference.md"
              },
              "when_state": {
                "type": "array",
                "items": { "type": "string", "pattern": "^SS_" },
                "description": "SS_* states that trigger this protection rule"
              },
              "applies_when": {
                "type": "object",
                "description": "Conditional application based on configuration dimensions (e.g., application_method)",
                "additionalProperties": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "when_finish_group": {
                "type": "string",
                "enum": ["same", "different"],
                "description": "Whether adjacent surface is in same or different finish group (color)"
              },
              "protection_zone": {
                "type": ["string", "null"],
                "description": "Zone ID from Protection_Zones_Reference.md, or null if no zone"
              },
              "protection_level": {
                "type": "string",
                "enum": ["none", "light_mask", "full_mask", "full_cover"],
                "description": "Masking intensity for adjacent finished surfaces"
              },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

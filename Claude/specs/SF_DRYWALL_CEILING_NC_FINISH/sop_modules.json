{
  "spec_family_id": "SF_DRYWALL_CEILING_FINISH_NC",
  "version": "0.1.0",
  "status": "draft",
  "review_required": true,

  "sop_modules": [
    {
      "module_id": "MOD_PROTECT_FOR_FINISH",
      "name": "Protect for Ceiling Finish",
      "purpose": "Protect walls, floors, and fixtures prior to ceiling finish application.",
      "applies_to": { "environment": ["new_construction_clean", "new_construction_active"] }
    },
    {
      "module_id": "MOD_APPLY_CEILING_FINISH",
      "name": "Apply Ceiling Finish Coats",
      "purpose": "Apply ceiling finish coats using selected method.",
      "applies_to": { "application_method": ["spray_only", "spray_backroll", "roll_only"] }
    },
    {
      "module_id": "MOD_SAND_AND_INSPECT",
      "name": "Sand and Inspect Between Coats",
      "purpose": "Inspect and sand ceilings between coats per quality level.",
      "applies_to": { "quality_level": ["QL-3", "QL-4", "QL-5"] }
    }
  ],

  "tasks": [
    {
      "task_id": "TSK_PROTECT_CEILING_R1",
      "module_id": "MOD_PROTECT_FOR_FINISH",
      "name": "Protect walls, floors, fixtures",
      "task_type": "protect",
      "round_number": 1,
      "inputs": ["plastic", "tape"],
      "outputs": ["protected_area"]
    },
    {
      "task_id": "TSK_APPLY_CEILING_COAT_1_R1",
      "module_id": "MOD_APPLY_CEILING_FINISH",
      "name": "Apply ceiling finish coat 1",
      "task_type": "finish",
      "round_number": 1,
      "inputs": ["finish_paint", "tools_by_method"],
      "outputs": ["coat_1_applied"]
    },
    {
      "task_id": "TSK_SAND_BETWEEN_COATS_R2",
      "module_id": "MOD_SAND_AND_INSPECT",
      "name": "Sand between coats (as required)",
      "task_type": "prep",
      "round_number": 2,
      "inputs": ["abrasives"],
      "outputs": ["surface_smoothed"]
    },
    {
      "task_id": "TSK_APPLY_CEILING_COAT_2_R3",
      "module_id": "MOD_APPLY_CEILING_FINISH",
      "name": "Apply ceiling finish coat 2",
      "task_type": "finish",
      "round_number": 3,
      "inputs": ["finish_paint", "tools_by_method"],
      "outputs": ["coat_2_applied"]
    },
    {
      "task_id": "TSK_FINAL_CEILING_INSPECTION_R4",
      "module_id": "MOD_SAND_AND_INSPECT",
      "name": "Final ceiling inspection",
      "task_type": "inspect",
      "round_number": 4,
      "inputs": ["lighting"],
      "outputs": ["ceiling_approved"]
    }
  ],

  "module_task_map": [
    {
      "module_id": "MOD_PROTECT_FOR_FINISH",
      "task_ids": ["TSK_PROTECT_CEILING_R1"]
    },
    {
      "module_id": "MOD_APPLY_CEILING_FINISH",
      "task_ids": ["TSK_APPLY_CEILING_COAT_1_R1", "TSK_APPLY_CEILING_COAT_2_R3"]
    },
    {
      "module_id": "MOD_SAND_AND_INSPECT",
      "task_ids": ["TSK_SAND_BETWEEN_COATS_R2", "TSK_FINAL_CEILING_INSPECTION_R4"]
    }
  ],

  "assumptions": [
    "Ceilings are primed and accepted prior to finish application."
  ],
  "exclusions": [
    "Ceiling priming and texture workflows."
  ]
}

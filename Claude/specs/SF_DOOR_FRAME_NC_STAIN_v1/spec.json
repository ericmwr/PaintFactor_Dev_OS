{
  "spec_family": {
    "id": "SF_DOOR_FRAME_NC_STAIN",
    "name": "New Construction Interior Door Frame Stain/Clear Coat",
    "description": "Covers stain application, sanding sealer, and clear topcoat for interior door frames (jamb, stop, head jamb) in new construction. Combined spec with coating_type dimension (stain_clear, stain_only, clear_only). Uses EA as primary UOM (per frame set). Shares 14-module SOP architecture and 9 shared material systems with canonical trim stain spec. Context prefix DFST avoids collision with paint counterpart SF_DOOR_FRAME_NC_FINISH.",
    "domain": "interior",
    "version": "0.1.0",
    "status": "draft",
    "review_required": true
  },

  "scope_boundaries": {
    "includes": [
      "Stain application on bare wood door frames (brush+wipe, spray+wipe)",
      "Second stain coat application (optional, user-selectable)",
      "Sanding sealer application (0-2 coats, QT-driven defaults)",
      "Clear topcoat application (1-3 coats, QT-driven defaults)",
      "Bare wood preparation (inspect, sand 120-150 grit, fill defects, grain raise, tack clean)",
      "Wood conditioner application (softwood + stain, unless gel stain)",
      "Interstage sanding between sealer and clear coats",
      "Stain dry verification before sealer/clear application",
      "Door frame jambs (left, right, head)",
      "Door stop molding",
      "Floor protection adjacent to door opening",
      "Wall masking (spray or when walls are SS_PAINTED_*)",
      "Final inspection and touch-up"
    ],
    "excludes": [
      { "item": "Door slab stain/clear coat", "route_to": "SF_DOOR_SLAB_INT_NC_STAIN" },
      { "item": "Door casing stain/clear coat", "route_to": "SF_TRIM_NC_STAIN" },
      { "item": "Paint workflows (prime + finish)", "route_to": "SF_DOOR_FRAME_NC_FINISH" },
      { "item": "Interior repaint stain", "route_to": "Future RP stain spec" },
      { "item": "Exterior door frame staining", "route_to": "Future exterior spec" }
    ]
  },

  "configuration_dimensions": [
    {
      "dimension_id": "coating_type",
      "values": ["stain_clear", "stain_only", "clear_only"],
      "default": "stain_clear",
      "notes": "Primary dimension driving layer stack and module activation."
    },
    {
      "dimension_id": "quality_tier",
      "values": ["QT3", "QT4", "QT5"],
      "default": "QT3",
      "notes": "QT3=2 coats, QT4=4 coats, QT5=6 coats."
    },
    {
      "dimension_id": "application_method_stain",
      "values": ["brush", "spray"],
      "default": "brush",
      "visible_when": "coating_type includes stain",
      "notes": "Brush default for frame detail. All methods include wipe step."
    },
    {
      "dimension_id": "application_method_clear",
      "values": ["brush", "spray"],
      "default": "brush",
      "visible_when": "coating_type includes clear",
      "notes": "Roll PROHIBITED for clear coat."
    },
    {
      "dimension_id": "clear_sheen",
      "values": ["satin", "semi-gloss", "gloss"],
      "default": "satin",
      "visible_when": "coating_type includes clear",
      "notes": "No sheen/QT gate."
    },
    {
      "dimension_id": "stain_coats",
      "values": [1, 2],
      "default": 1,
      "visible_when": "coating_type includes stain"
    },
    {
      "dimension_id": "sealer_coats",
      "values": [0, 1, 2],
      "default_by_qt": { "QT3": 0, "QT4": 1, "QT5": 2 },
      "visible_when": "coating_type includes clear"
    },
    {
      "dimension_id": "clear_coats",
      "values": [1, 2, 3],
      "default_by_qt": { "QT3": 1, "QT4": 2, "QT5": 3 },
      "visible_when": "coating_type includes clear"
    },
    {
      "dimension_id": "profile_complexity",
      "values": ["simple", "standard", "complex", "ornate"],
      "default": "standard",
      "modifiers": { "simple": 0.85, "standard": 1.00, "complex": 1.25, "ornate": 1.40 },
      "notes": "Frame profile complexity. Standard for typical residential frames."
    },
    {
      "dimension_id": "wood_species_group",
      "values": ["softwood", "hardwood"],
      "default": "hardwood",
      "notes": "Softwood requires pre-stain conditioner unless gel stain."
    }
  ],

  "paintable_items": [
    {
      "item_id": "ITM_DOOR_FRAME",
      "name": "Door frame set (jamb + stop)",
      "unit_of_measure": "EA",
      "counting_rules": "1 per door opening. Includes both jamb sides, head jamb, and all stop surfaces.",
      "notes": "Primary paintable item. EA per frame set."
    },
    {
      "item_id": "ITM_DOOR_JAMB",
      "name": "Door jamb",
      "unit_of_measure": "EA",
      "counting_rules": "Included in frame set count — not separate.",
      "notes": "Bundled with frame set. Jambs are the primary painted surfaces."
    }
  ],

  "variants": [
    {
      "variant_id": "VAR_DFST_QT3_STAIN_CLEAR_BRUSH",
      "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT3"], "application_method_stain": ["brush"], "application_method_clear": ["brush"] },
      "coats": { "stain": 1, "sealer": 0, "clear": 1 },
      "notes": "Budget stain+clear. 2 total coats."
    },
    {
      "variant_id": "VAR_DFST_QT4_STAIN_CLEAR_BRUSH",
      "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT4"], "application_method_stain": ["brush"], "application_method_clear": ["brush"] },
      "coats": { "stain": 1, "sealer": 1, "clear": 2 },
      "notes": "Standard stain+clear. 4 total coats."
    },
    {
      "variant_id": "VAR_DFST_QT5_STAIN_CLEAR_BRUSH",
      "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT5"], "application_method_stain": ["brush"], "application_method_clear": ["brush"] },
      "coats": { "stain": 1, "sealer": 2, "clear": 3 },
      "notes": "Premium stain+clear. 6 total coats."
    },
    {
      "variant_id": "VAR_DFST_QT4_STAIN_CLEAR_SPRAY_SPRAY",
      "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT4"], "application_method_stain": ["spray"], "application_method_clear": ["spray"] },
      "coats": { "stain": 1, "sealer": 1, "clear": 2 },
      "protection_zones": ["floor_adjacent", "wall_adjacent"],
      "notes": "Production spray variant."
    },
    {
      "variant_id": "VAR_DFST_QT3_STAIN_ONLY_BRUSH",
      "applies_when": { "coating_type": ["stain_only"], "quality_tier": ["QT3"], "application_method_stain": ["brush"] },
      "coats": { "stain": 1 },
      "notes": "Stain-only. Minimal workflow."
    },
    {
      "variant_id": "VAR_DFST_QT4_CLEAR_ONLY_BRUSH",
      "applies_when": { "coating_type": ["clear_only"], "quality_tier": ["QT4"], "application_method_clear": ["brush"] },
      "coats": { "sealer": 1, "clear": 2 },
      "notes": "Clear-only on natural or pre-stained wood."
    }
  ],

  "required_paintscope_inputs": [
    { "input_name": "IN_EA_DOOR_FRAME_STAIN", "paintscope_key": "PS_SURFACE_EA.DOOR_FRAME_STAIN", "uom": "EA", "required": true, "description": "Count of door frame sets to stain" },
    { "input_name": "IN_SF_PROTECT_FLOOR_ADJACENT", "paintscope_key": "PS_PROTECT_SF.FLOOR_ADJACENT", "uom": "SF", "required": true, "required_when": "floor_type = finished or partial", "description": "Floor protection area adjacent to door opening" },
    { "input_name": "IN_LF_WALL_ADJACENT", "paintscope_key": "PS_PROTECT_LF.WALL_ADJACENT", "uom": "LF", "required": false, "required_when": "spray or walls SS_PAINTED_*", "description": "Wall masking LF adjacent to door opening" }
  ],

  "protection_zones_required": [
    { "zone_id": "floor_adjacent", "condition": { "floor_type": ["finished", "partial"] }, "protection_level": "edge_only", "notes": "Drop cloths adjacent to door opening. Stain drips critical." },
    { "zone_id": "wall_adjacent", "condition": { "application_method_stain": ["spray"], "application_method_clear": ["spray"] }, "protection_level": "light_mask", "notes": "Wall masking for spray. Also required when walls SS_PAINTED_*." }
  ],

  "adjacency_declarations": {
    "primary_surface": "door_frame",
    "adjacent_surfaces": [
      { "surface_id": "door_casing", "edge_type": "complex", "typical_relationship": "same_finish", "continuity_rate_modifier": 1.15, "notes": "Frame and casing typically same stain finish." },
      { "surface_id": "door_slab", "edge_type": "complex", "typical_relationship": "same_finish", "continuity_rate_modifier": 1.0, "notes": "Door slab meets frame at reveal. Often same stain." },
      { "surface_id": "wall_field", "edge_type": "linear", "typical_relationship": "different_finish", "continuity_rate_modifier": 1.0, "notes": "Frame meets drywall at reveal edge." }
    ]
  },

  "state_declarations": {
    "primary_surface": "door_frame",
    "valid_input_states": {
      "states_by_coating_type": { "stain_clear": ["SS_BARE"], "stain_only": ["SS_BARE"], "clear_only": ["SS_BARE", "SS_STAINED"] }
    },
    "output_state": {
      "varies_by": "coating_type",
      "state_map": { "stain_clear": "SS_CLEAR_COATED", "stain_only": "SS_STAINED", "clear_only": "SS_CLEAR_COATED" }
    },
    "adjacent_state_protection_rules": [
      { "adjacent_surface": "wall_field", "when_state": ["SS_PAINTED_FLAT", "SS_PAINTED_EGGSHELL", "SS_PAINTED_SATIN", "SS_PAINTED_SEMIGLOSS"], "protection_zone": "wall_adjacent", "protection_level": "light_mask", "applies_when": { "application_method_stain": ["spray", "brush"], "application_method_clear": ["spray", "brush"] }, "notes": "Wall masking for ALL methods when walls finished." },
      { "adjacent_surface": "wall_field", "when_state": ["SS_BARE", "SS_PRIMED_FIELD"], "protection_zone": "wall_adjacent", "protection_level": "light_mask", "applies_when": { "application_method_stain": ["spray"], "application_method_clear": ["spray"] }, "notes": "Spray requires masking even on unfinished walls." }
    ]
  },

  "site_condition_rules": [
    { "condition_id": "floor_type", "include_when": ["finished", "partial"], "exclude_when": ["subfloor"], "affected_tasks": ["TSK_DFST_FLOOR_PROTECT", "TSK_DFST_REMOVE_MASK"], "effect": "Floor protection excluded when subfloor." }
  ],

  "sequencing_notes": {
    "production_sequence": "Stain frames typically before wall finishing in NC. Often in same session as door slab stain.",
    "coat_sequence": "Setup > Prep > Stain > Stain dry > Sealer > Sealer sand > Clear coats > Cleanup",
    "companion_spec": null
  },

  "relationships": {
    "companion_spec": null,
    "paint_counterpart": "SF_DOOR_FRAME_NC_FINISH",
    "often_combined_with": ["SF_DOOR_SLAB_INT_NC_STAIN", "SF_TRIM_NC_STAIN"],
    "shares_finish_group_with": ["SF_DOOR_SLAB_INT_NC_STAIN", "SF_TRIM_NC_STAIN"]
  },

  "dependencies": {

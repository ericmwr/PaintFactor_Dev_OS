      { "item": "Stone/brick/tile fireplace surround", "route_to": "Not painting scope" },
      { "item": "Paint workflows", "route_to": "SF_ARCH_ELEMENT_NC" },
      { "item": "Stair newel posts", "route_to": "Future SF_STAIR_RAILING_NC_STAIN" }
    ]
  },


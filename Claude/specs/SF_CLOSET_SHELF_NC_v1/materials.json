{
  "spec_family_id": "SF_CLOSET_SHELF_NC",
  "version": "0.1.0",
  "materials_date": "2026-02-03",

  "material_systems": [
    {
      "system_id": "SYS_CLOSET_SHELF_STANDARD",
      "name": "Standard Acrylic Enamel System",
      "quality_tier": ["QT2", "QT3"],
      "description": "Standard 100% acrylic enamel for closet shelving. Cost-effective, durable for light use.",
      "primer": {
        "products": ["Acrylic primer-sealer"],
        "coverage_sf_per_gallon": 350,
        "coats": 1,
        "conditional": {
          "include_when": { "substrate_state": ["SS_BARE"] },
          "exclude_when": { "substrate_state": ["SS_PRIMED_FACTORY"] }
        }
      },
      "edge_sealer": {
        "products": ["Solvent-based MDF edge sealer"],
        "coverage_lf_per_quart": 200,
        "coats": 1,
        "conditional": {
          "include_when": { "substrate_state": ["SS_BARE"], "substrate_type": ["mdf"] }
        },
        "notes": "Prevents fiber raise on MDF edges per Millwork Doctrine"
      },
      "finish": {
        "products": ["100% Acrylic enamel"],
        "coverage_sf_per_gallon": 400,
        "coats": {
          "QT2": 1,
          "QT3": 2
        }
      },
      "allowed_sheens": ["flat", "eggshell", "satin"]
    },
    {
      "system_id": "SYS_CLOSET_SHELF_PREMIUM",
      "name": "Premium Waterborne Urethane System",
      "quality_tier": ["QT4", "QT5"],
      "description": "Waterborne urethane for superior durability and smooth finish on closet shelving.",
      "primer": {
        "products": ["High-build primer-surfacer"],
        "coverage_sf_per_gallon": 300,
        "coats": 1,
        "conditional": {
          "include_when": { "substrate_state": ["SS_BARE"] },
          "exclude_when": { "substrate_state": ["SS_PRIMED_FACTORY"] }
        }
      },
      "edge_sealer": {
        "products": ["Solvent-based MDF edge sealer"],
        "coverage_lf_per_quart": 200,
        "coats": 1,
        "conditional": {
          "include_when": { "substrate_state": ["SS_BARE"], "substrate_type": ["mdf"] }
        }
      },
      "finish": {
        "products": ["Waterborne urethane enamel"],
        "coverage_sf_per_gallon": 350,
        "coats": 2
      },
      "interstage_sand": {
        "grit": {
          "QT4": 220,
          "QT5": 320
        },
        "between_coats": true
      },
      "allowed_sheens": ["satin", "semi-gloss"]
    }
  ],

  "consumables": [
    {
      "consumable_id": "CON_BRUSH_ANGLE",
      "name": "Angled sash brush 2\"",
      "usage_rate": "1 per 20 openings",
      "applies_when": { "application_method": ["brush_roll"] }
    },
    {
      "consumable_id": "CON_ROLLER_MINI",
      "name": "Mini roller 4\" foam",
      "usage_rate": "1 per 15 openings",
      "applies_when": { "application_method": ["brush_roll"] }
    },
    {
      "consumable_id": "CON_SANDPAPER",
      "name": "Sandpaper sheets",
      "usage_rate": "1 sheet per 10 openings",
      "grit_by_tier": {
        "QT2": 150,
        "QT3": 180,
        "QT4": 220,
        "QT5": 320
      }
    },
    {
      "consumable_id": "CON_TACK_CLOTH",
      "name": "Tack cloth",
      "usage_rate": "1 per 30 openings"
    },
    {
      "consumable_id": "CON_DROP_CLOTH",
      "name": "Canvas drop cloth 4x12",
      "usage_rate": "1 per closet",
      "conditional": {
        "include_when": { "floor_type": ["finished", "partial"] }
      }
    },
    {
      "consumable_id": "CON_CAULK",
      "name": "Paintable acrylic caulk",
      "usage_rate": "1 tube per 10 openings",
      "notes": "Standard paintable caulk for shelf-to-wall gaps and joints"
    }
  ],

  "coverage_notes": [
    "Coverage rates based on opening equivalent SF (tier-adjusted)",
    "S opening ≈ 2 SF, M opening ≈ 5 SF, L opening ≈ 10 SF, XL opening ≈ 20 SF",
    "These are material planning estimates, not production rate drivers"
  ]
}

{
  "spec_family_id": "SF_CLOSET_SHELF_NC",
  "version": "0.1.0",
  "sop_date": "2026-02-03",

  "sop_modules": [
    {
      "module_id": "MOD_CLOSET_SHELF_SETUP",
      "name": "Closet Shelf Setup",
      "phase": "setup",
      "required_inputs": [
        { "input_name": "IN_SF_FLOOR_WORKZONE", "paintscope_key": "PS_PROTECT_SF.FLOOR_WORKZONE", "uom": "SF" }
      ],
      "tasks": [
        {
          "task_id": "TSK_FLOOR_PROTECT",
          "name": "Floor protection setup",
          "task_type": "protect",
          "task_classification": "binary",
          "skill_level": "helper",
          "protection_metadata": {
            "action": "setup",
            "zones": ["floor_workzone"],
            "method_dependent": false
          },
          "site_condition_rules": {
            "include_when": { "floor_type": ["finished", "partial"] },
            "exclude_when": { "floor_type": ["subfloor"] }
          },
          "notes": "Drop cloth under closet opening. Excluded when subfloor."
        }
      ]
    },
    {
      "module_id": "MOD_CLOSET_SHELF_PREP",
      "name": "Closet Shelf Prep",
      "phase": "prep",
      "required_inputs": [
        { "input_name": "IN_EA_OPENING_S", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.S", "uom": "EA" },
        { "input_name": "IN_EA_OPENING_M", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.M", "uom": "EA" },
        { "input_name": "IN_EA_OPENING_L", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.L", "uom": "EA" },
        { "input_name": "IN_EA_OPENING_XL", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.XL", "uom": "EA" }
      ],
      "tasks": [
        {
          "task_id": "TSK_DUST_WIPE",
          "name": "Dust and wipe surfaces",
          "task_type": "prep",
          "task_classification": "binary",
          "skill_level": "helper",
          "applies_when": { "substrate_state": ["SS_BARE", "SS_PRIMED_FACTORY"] },
          "notes": "Wipe dust from all shelf surfaces before coating"
        },
        {
          "task_id": "TSK_LIGHT_SAND",
          "name": "Light sand surfaces",
          "task_type": "prep",
          "task_classification": "qt_scaled",
          "skill_level": "journeyman",
          "applies_when": { "substrate_state": ["SS_PRIMED_FACTORY"] },
          "notes": "Scuff sand factory primer for adhesion"
        },
        {
          "task_id": "TSK_EDGE_SEAL",
          "name": "Seal MDF edges",
          "task_type": "prep",
          "task_classification": "binary",
          "skill_level": "journeyman",
          "substrate_state_rules": {
            "include_when": ["SS_BARE"],
            "exclude_when": ["SS_PRIMED_FACTORY"]
          },
          "notes": "Solvent-based sealer on MDF edges to prevent fiber raise. Per Millwork Doctrine."
        },
        {
          "task_id": "TSK_SPOT_FILL",
          "name": "Spot fill defects",
          "task_type": "prep",
          "task_classification": "qt_scaled",
          "skill_level": "journeyman",
          "notes": "Fill nail holes, minor defects. Effort scales with QT."
        },
        {
          "task_id": "TSK_CAULK",
          "name": "Caulk gaps and joints",
          "task_type": "prep",
          "task_classification": "binary",
          "skill_level": "journeyman",
          "notes": "Caulk shelf-to-wall gaps, cleat joints, and component seams. Standard paintable caulk."
        }
      ]
    },
    {
      "module_id": "MOD_CLOSET_SHELF_PRIME",
      "name": "Closet Shelf Prime",
      "phase": "prime",
      "required_inputs": [
        { "input_name": "IN_EA_OPENING_S", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.S", "uom": "EA" },
        { "input_name": "IN_EA_OPENING_M", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.M", "uom": "EA" },
        { "input_name": "IN_EA_OPENING_L", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.L", "uom": "EA" },
        { "input_name": "IN_EA_OPENING_XL", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.XL", "uom": "EA" }
      ],
      "tasks": [
        {
          "task_id": "TSK_PRIME_BRUSH_ROLL",
          "name": "Prime - brush and roll",
          "task_type": "prime",
          "task_classification": "binary",
          "skill_level": "journeyman",
          "applies_when": { "application_method": ["brush_roll"] },
          "substrate_state_rules": {
            "include_when": ["SS_BARE"],
            "exclude_when": ["SS_PRIMED_FACTORY"]
          },
          "notes": "Brush and roll primer on bare wood/MDF"
        },
        {
          "task_id": "TSK_PRIME_SPRAY",
          "name": "Prime - spray",
          "task_type": "prime",
          "task_classification": "binary",
          "skill_level": "journeyman",
          "applies_when": { "application_method": ["spray"] },
          "substrate_state_rules": {
            "include_when": ["SS_BARE"],
            "exclude_when": ["SS_PRIMED_FACTORY"]
          },
          "notes": "Spray primer on bare surfaces (pre-installation scenario)"
        },
        {
          "task_id": "TSK_PRIME_SPRAY_ROLLOFF",
          "name": "Prime - spray with rolloff",
          "task_type": "prime",
          "task_classification": "binary",
          "skill_level": "journeyman",
          "applies_when": { "application_method": ["spray_rolloff"] },
          "substrate_state_rules": {
            "include_when": ["SS_BARE"],
            "exclude_when": ["SS_PRIMED_FACTORY"]
          },
          "notes": "Spray + immediate rolloff to work primer into wood grain. Required for bare wood."
        }
      ]
    },
    {
      "module_id": "MOD_CLOSET_SHELF_FINISH",
      "name": "Closet Shelf Finish",
      "phase": "finish",
      "required_inputs": [
        { "input_name": "IN_EA_OPENING_S", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.S", "uom": "EA" },
        { "input_name": "IN_EA_OPENING_M", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.M", "uom": "EA" },
        { "input_name": "IN_EA_OPENING_L", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.L", "uom": "EA" },
        { "input_name": "IN_EA_OPENING_XL", "paintscope_key": "PS_OPENING_EA.CLOSET_SHELF.XL", "uom": "EA" }
      ],
      "tasks": [
        {
          "task_id": "TSK_FINISH_BRUSH_ROLL",
          "name": "Finish coat - brush and roll",
          "task_type": "finish",
          "task_classification": "qt_scaled",
          "skill_level": "journeyman",
          "applies_when": { "application_method": ["brush_roll"] },
          "notes": "Brush and roll finish coat(s). Coat count per QT."
        },
        {
          "task_id": "TSK_FINISH_SPRAY",
          "name": "Finish coat - spray",
          "task_type": "finish",
          "task_classification": "qt_scaled",
          "skill_level": "journeyman",
          "applies_when": { "application_method": ["spray", "spray_rolloff"] },
          "notes": "Spray finish coat(s). Coat count per QT."
        },
        {
          "task_id": "TSK_INTERSTAGE_SAND",
          "name": "Sand between coats",
          "task_type": "prep",
          "task_classification": "qt_scaled",
          "skill_level": "journeyman",
          "applies_when": { "quality_tier": ["QT4", "QT5"] },
          "notes": "Sand between finish coats for QT4/QT5. Grit per Modifier_Registry."
        }
      ]
    },
    {
      "module_id": "MOD_CLOSET_SHELF_CLEANUP",
      "name": "Closet Shelf Cleanup",
      "phase": "cleanup",
      "tasks": [
        {
          "task_id": "TSK_FLOOR_PROTECT_TEARDOWN",
          "name": "Floor protection teardown",
          "task_type": "protect",
          "task_classification": "binary",
          "skill_level": "helper",
          "protection_metadata": {
            "action": "teardown",
            "zones": ["floor_workzone"]
          },
          "site_condition_rules": {
            "include_when": { "floor_type": ["finished", "partial"] },
            "exclude_when": { "floor_type": ["subfloor"] }
          },
          "notes": "Remove floor protection. Excluded when subfloor."
        },
        {
          "task_id": "TSK_FINAL_INSPECT",
          "name": "Final inspection",
          "task_type": "detail",
          "task_classification": "qt_scaled",
          "skill_level": "journeyman",
          "notes": "Inspect per QT inspection distance. Touch-up as needed."
        }
      ]
    }
  ]
}

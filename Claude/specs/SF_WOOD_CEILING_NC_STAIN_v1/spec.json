{
  "spec_family": {
    "id": "SF_WOOD_CEILING_NC_STAIN",
    "name": "New Construction Wood Ceiling Stain/Clear Coat",
    "description": "Covers stain application, sanding sealer, and clear topcoat for wood ceiling panel/board surfaces in new construction. Combined spec with coating_type dimension (stain_clear, stain_only, clear_only). ALL work is overhead — base production rates include overhead penalty (1.15-1.25x slower than equivalent wood wall rates). Ceiling_style (plank, beadboard, coffered) drives complexity modifier. Uses SF as primary UOM. Material systems are product-role-based recommendations. Context prefix WCST avoids collision with WDCL (SF_WOOD_CEILING_NC paint).",
    "domain": "interior",
    "version": "0.1.0",
    "status": "draft",
    "review_required": true
  },

  "scope_boundaries": {
    "includes": [
      "Stain application on bare wood ceiling (brush+wipe, roll+wipe, spray+wipe)",
      "Second stain coat (optional, user-selectable)",
      "Sanding sealer application (0-2 coats, QT-driven defaults)",
      "Clear topcoat application (1-3 coats, QT-driven defaults)",
      "Bare wood preparation (inspect, sand 120-150 grit, fill defects, grain raise, tack clean)",
      "Wood conditioner application (softwood + stain, unless gel stain)",
      "Interstage sanding between sealer/clear coats",
      "Full floor protection (spray) or perimeter (brush)",
      "Wall edge masking at ceiling-wall junction (spray or when walls are SS_PAINTED_*)",
      "Ceiling fixture masking (always required)",
      "Plank ceiling stain/clear coat",
      "Beadboard ceiling stain/clear coat",
      "Coffered ceiling stain/clear coat (beams integral to ceiling system)"
    ],
    "excludes": [
      { "item": "Crown molding stain/clear coat", "route_to": "SF_TRIM_NC_STAIN" },
      { "item": "Standalone decorative beams (not part of coffered grid)", "route_to": "SF_ARCH_ELEMENT_NC_STAIN" },
      { "item": "Paint workflows", "route_to": "SF_WOOD_CEILING_NC" },
      { "item": "Drywall ceiling", "route_to": "SF_DRYWALL_CEILING_NC_FINISH" },
      { "item": "Interior repaint stain", "route_to": "Future RP stain spec" }
    ]
  },

  "configuration_dimensions": [
    {
      "dimension_id": "coating_type",
      "values": ["stain_clear", "stain_only", "clear_only"],
      "default": "stain_clear"
    },
    {
      "dimension_id": "quality_tier",
      "values": ["QT3", "QT4"],
      "default": "QT3",
      "notes": "QT3-QT4 only. Wood ceilings are field surfaces."
    },
    {
      "dimension_id": "application_method_stain",
      "values": ["brush", "roll", "spray"],
      "default": "spray",
      "visible_when": "coating_type includes stain",
      "notes": "Spray strongly preferred for overhead — faster, more ergonomic."
    },
    {
      "dimension_id": "application_method_clear",
      "values": ["brush", "spray"],
      "default": "spray",
      "visible_when": "coating_type includes clear",
      "notes": "Spray preferred for overhead. Roll PROHIBITED for clear coat."
    },
    {
      "dimension_id": "clear_sheen",
      "values": ["satin", "semi-gloss", "gloss"],
      "default": "satin",
      "visible_when": "coating_type includes clear"
    },
    {
      "dimension_id": "stain_coats",
      "values": [1, 2],
      "default": 1,
      "visible_when": "coating_type includes stain"
    },
    {
      "dimension_id": "sealer_coats",
      "values": [0, 1, 2],
      "default_by_qt": { "QT3": 0, "QT4": 1 },
      "visible_when": "coating_type includes clear"
    },
    {
      "dimension_id": "clear_coats",
      "values": [1, 2, 3],
      "default_by_qt": { "QT3": 1, "QT4": 2 },
      "visible_when": "coating_type includes clear"
    },
    {
      "dimension_id": "ceiling_style",
      "description": "Wood ceiling construction type. Drives complexity modifier.",
      "values": ["plank", "beadboard", "coffered"],
      "default": "plank",
      "modifiers": {
        "plank": 1.00,
        "beadboard": 1.15,
        "coffered": 1.35
      },
      "notes": "plank=baseline. beadboard=1.15x (narrow boards, high joint density overhead). coffered=1.35x (beam faces + panel fields + inside corners)."
    },
    {
      "dimension_id": "wood_species_group",
      "values": ["softwood", "hardwood"],
      "default": "hardwood"
    }
  ],

  "paintable_items": [
    {
      "item_id": "ITM_WOOD_CEILING",
      "name": "Wood ceiling panel/board surface",
      "unit_of_measure": "SF",
      "counting_rules": "Total SF of wood ceiling surface. For coffered, includes panel faces AND beam faces. Sourced from PS_SURFACE_SF.WOOD_CEILING.",
      "notes": "ALL work is overhead. Height modifier applies via PS_META.HEIGHT_BAND on top of overhead penalty already in base rates."
    }
  ],

  "variants": [
    {
      "variant_id": "VAR_WCST_QT3_STAIN_CLEAR_SPRAY",
      "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT3"], "application_method_stain": ["spray"], "application_method_clear": ["spray"] },
      "coats": { "stain": 1, "sealer": 0, "clear": 1 },
      "protection_zones": ["floor_full", "wall_edge", "fixture_covers"],
      "notes": "Budget spray. 2 total coats. Most common NC overhead scenario."
    },
    {
      "variant_id": "VAR_WCST_QT4_STAIN_CLEAR_SPRAY",
      "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT4"], "application_method_stain": ["spray"], "application_method_clear": ["spray"] },
      "coats": { "stain": 1, "sealer": 1, "clear": 2 },
      "protection_zones": ["floor_full", "wall_edge", "fixture_covers"],
      "notes": "Standard spray. 4 total coats."
    },
    {
      "variant_id": "VAR_WCST_QT3_STAIN_CLEAR_BRUSH",
      "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT3"], "application_method_stain": ["brush"], "application_method_clear": ["brush"] },
      "coats": { "stain": 1, "sealer": 0, "clear": 1 },
      "protection_zones": ["floor_perimeter", "fixture_covers"],
      "notes": "Budget brush. Slower overhead."
    },
    {
      "variant_id": "VAR_WCST_QT4_STAIN_CLEAR_BRUSH",
      "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT4"], "application_method_stain": ["brush"], "application_method_clear": ["brush"] },
      "coats": { "stain": 1, "sealer": 1, "clear": 2 },
      "protection_zones": ["floor_perimeter", "fixture_covers"],
      "notes": "Standard brush. 4 total coats overhead."
    },
    {
      "variant_id": "VAR_WCST_QT3_STAIN_ONLY_SPRAY",
      "applies_when": { "coating_type": ["stain_only"], "quality_tier": ["QT3"], "application_method_stain": ["spray"] },
      "coats": { "stain": 1 },
      "notes": "Stain-only spray."
    },
    {
      "variant_id": "VAR_WCST_QT4_CLEAR_ONLY_SPRAY",
      "applies_when": { "coating_type": ["clear_only"], "quality_tier": ["QT4"], "application_method_clear": ["spray"] },
      "coats": { "sealer": 1, "clear": 2 },
      "protection_zones": ["floor_full", "wall_edge", "fixture_covers"],
      "notes": "Clear-only spray on natural/pre-stained wood."
    }
  ],

  "required_paintscope_inputs": [
    { "input_name": "IN_SF_WOOD_CEILING", "paintscope_key": "PS_SURFACE_SF.WOOD_CEILING", "uom": "SF", "required": true },
    { "input_name": "IN_SF_PROTECT_FLOOR_EXPOSED", "paintscope_key": "PS_PROTECT_SF.FLOOR_EXPOSED", "uom": "SF", "required": false, "required_when": "spray method" },
    { "input_name": "IN_SF_PROTECT_FLOOR_PERIMETER", "paintscope_key": "PS_PROTECT_SF.FLOOR_PERIMETER", "uom": "SF", "required": false, "required_when": "brush method" },
    { "input_name": "IN_LF_PROTECT_WALL_EDGE", "paintscope_key": "PS_PROTECT_LF.WALL_EDGE", "uom": "LF", "required": false, "required_when": "spray or walls SS_PAINTED_*" },
    { "input_name": "IN_EA_PROTECT_FIXTURES", "paintscope_key": "PS_PROTECT_EA.ASSET.FIXTURES", "uom": "EA", "required": true, "description": "Ceiling fixtures always need masking" },
    { "input_name": "IN_ENUM_HEIGHT_BAND", "paintscope_key": "PS_META.HEIGHT_BAND", "uom": "ENUM", "required": true }
  ],

  "protection_zones_required": [
    { "zone_id": "floor_full", "condition": { "application_method_stain": ["spray"], "application_method_clear": ["spray"] }, "protection_level": "full_cover", "notes": "Overhead spray overspray falls on entire floor." },
    { "zone_id": "floor_perimeter", "condition": { "application_method_stain": ["brush", "roll"], "application_method_clear": ["brush"] }, "protection_level": "edge_only" },
    { "zone_id": "wall_edge", "condition": { "application_method_stain": ["spray"], "application_method_clear": ["spray"] }, "protection_level": "partial_cover", "notes": "Masking at ceiling-wall junction." },
    { "zone_id": "fixture_covers", "condition": "always", "protection_level": "full_cover", "notes": "Ceiling fixtures always masked — embedded in work surface." }
  ],

  "state_declarations": {
    "primary_surface": "wood_ceiling",
    "valid_input_states": {
      "states_by_coating_type": { "stain_clear": ["SS_BARE"], "stain_only": ["SS_BARE"], "clear_only": ["SS_BARE", "SS_STAINED"] }
    },
    "output_state": {
      "varies_by": "coating_type",
      "state_map": { "stain_clear": "SS_CLEAR_COATED", "stain_only": "SS_STAINED", "clear_only": "SS_CLEAR_COATED" }
    }
  },

  "relationships": {
    "paint_counterpart": "SF_WOOD_CEILING_NC",
    "often_combined_with": ["SF_WOOD_WALL_NC_STAIN", "SF_TRIM_NC_STAIN"],
    "shares_finish_group_with": ["SF_WOOD_WALL_NC_STAIN", "SF_TRIM_NC_STAIN"]
  },

  "dependencies": {
    "research": "research.json",
    "resolution": "resolution.json",
    "materials": "materials.json",
    "sop_modules": "sop_modules.json",
    "production": "production.json",
    "qa_report": "qa_report.json"
  },

  "change_log": [
    {
      "version": "0.1.0",
      "date": "2026-03-18",
      "author": "SpecFactory",
      "changes": "Initial draft. Wood ceiling stain/clear coat with overhead penalty in base rates (1.15-1.25x slower than wall), ceiling_style modifier (plank/beadboard/coffered), height_band modifier on top, QT3-QT4, fixture masking always required. Context prefix WCST."
    }
  ]
}
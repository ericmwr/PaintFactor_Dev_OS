{
  "spec_family": {
    "id": "SF_WAINSCOT_PANEL_NC_STAIN",
    "name": "New Construction Wainscot Panel Stain/Clear Coat",
    "description": "Covers stain application, sanding sealer, and clear topcoat for wainscot panel assemblies in new construction. Combined spec with coating_type dimension (stain_clear, stain_only, clear_only). Panel_style (flat, raised, recessed) drives complexity modifier. Always H1 height (32-42 inches, no height modifier). Cap rail excluded — routed to SF_TRIM_NC_STAIN. Uses SF as primary UOM. Context prefix WPST.",
    "domain": "interior",
    "version": "0.1.0",
    "status": "draft",
    "review_required": true
  },

  "scope_boundaries": {
    "includes": [
      "Stain application on bare wainscot panels (brush+wipe, roll+wipe, spray+wipe)",
      "Second stain coat (optional)",
      "Sanding sealer application (0-2 coats)",
      "Clear topcoat application (1-3 coats)",
      "Bare wood preparation (inspect, sand, fill, grain raise, tack clean)",
      "Wood conditioner (softwood + stain, unless gel stain)",
      "Panel-to-frame internal joint detail staining",
      "Floor perimeter protection",
      "Wall above masking (spray or when wall is SS_PAINTED_*)",
      "Flat panel wainscot stain/clear",
      "Raised panel wainscot stain/clear",
      "Recessed panel wainscot stain/clear"
    ],
    "excludes": [
      { "item": "Cap rail stain/clear coat", "route_to": "SF_TRIM_NC_STAIN (ITM_TRIM_WAINSCOT_RAIL)" },
      { "item": "Baseboard stain/clear coat", "route_to": "SF_TRIM_NC_STAIN (ITM_TRIM_BASEBOARD)" },
      { "item": "Wall field above wainscot", "route_to": "SF_DRYWALL_WALL_NC_FINISH" },
      { "item": "Full-height wood wall stain", "route_to": "SF_WOOD_WALL_NC_STAIN" },
      { "item": "Paint workflows", "route_to": "SF_WAINSCOT_PANEL_NC" }
    ]
  },

  "configuration_dimensions": [
    { "dimension_id": "coating_type", "values": ["stain_clear", "stain_only", "clear_only"], "default": "stain_clear" },
    { "dimension_id": "quality_tier", "values": ["QT3", "QT4"], "default": "QT3", "notes": "QT3-QT4 only." },
    { "dimension_id": "application_method_stain", "values": ["brush", "roll", "spray"], "default": "brush", "visible_when": "coating_type includes stain", "notes": "Brush is default — wainscot is detail work at low height. Roll for flat panels. Spray for production." },
    { "dimension_id": "application_method_clear", "values": ["brush", "spray"], "default": "brush", "visible_when": "coating_type includes clear" },
    { "dimension_id": "clear_sheen", "values": ["satin", "semi-gloss", "gloss"], "default": "satin", "visible_when": "coating_type includes clear" },
    { "dimension_id": "stain_coats", "values": [1, 2], "default": 1 },
    { "dimension_id": "sealer_coats", "values": [0, 1, 2], "default_by_qt": { "QT3": 0, "QT4": 1 } },
    { "dimension_id": "clear_coats", "values": [1, 2, 3], "default_by_qt": { "QT3": 1, "QT4": 2 } },
    {
      "dimension_id": "panel_style",
      "description": "Panel construction type. Drives complexity modifier.",
      "values": ["flat", "raised", "recessed"],
      "default": "flat",
      "modifiers": { "flat": 1.00, "raised": 1.25, "recessed": 1.15 },
      "notes": "flat=baseline. raised=1.25x (3D profile, detail edges, stain pools in profile transitions). recessed=1.15x (inset panels, less detail than raised)."
    },
    { "dimension_id": "wood_species_group", "values": ["softwood", "hardwood"], "default": "hardwood" }
  ],

  "paintable_items": [
    {
      "item_id": "ITM_WAINSCOT_PANEL",
      "name": "Wainscot panel assembly",
      "unit_of_measure": "SF",
      "counting_rules": "Total SF of wainscot panel assembly below cap rail. Includes panels, rails, stiles, base rail, applied molding. Sourced from PS_SURFACE_SF.WAINSCOTING.",
      "notes": "Always H1 (32-42 inches). No height modifier. Low height = comfortable ergonomic working position."
    }
  ],

  "variants": [
    { "variant_id": "VAR_WPST_QT3_STAIN_CLEAR_BRUSH", "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT3"], "application_method_stain": ["brush"], "application_method_clear": ["brush"] }, "coats": { "stain": 1, "sealer": 0, "clear": 1 }, "notes": "Budget brush. 2 total coats." },
    { "variant_id": "VAR_WPST_QT4_STAIN_CLEAR_BRUSH", "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT4"], "application_method_stain": ["brush"], "application_method_clear": ["brush"] }, "coats": { "stain": 1, "sealer": 1, "clear": 2 }, "notes": "Standard brush. 4 total coats." },
    { "variant_id": "VAR_WPST_QT3_STAIN_CLEAR_SPRAY", "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT3"], "application_method_stain": ["spray"], "application_method_clear": ["spray"] }, "coats": { "stain": 1, "sealer": 0, "clear": 1 }, "protection_zones": ["floor_perimeter", "wall_above"], "notes": "Budget spray." },
    { "variant_id": "VAR_WPST_QT4_STAIN_CLEAR_SPRAY", "applies_when": { "coating_type": ["stain_clear"], "quality_tier": ["QT4"], "application_method_stain": ["spray"], "application_method_clear": ["spray"] }, "coats": { "stain": 1, "sealer": 1, "clear": 2 }, "protection_zones": ["floor_perimeter", "wall_above"], "notes": "Standard spray. 4 total coats." },
    { "variant_id": "VAR_WPST_QT3_STAIN_ONLY_BRUSH", "applies_when": { "coating_type": ["stain_only"], "quality_tier": ["QT3"], "application_method_stain": ["brush"] }, "coats": { "stain": 1 }, "notes": "Stain-only brush." },
    { "variant_id": "VAR_WPST_QT4_CLEAR_ONLY_BRUSH", "applies_when": { "coating_type": ["clear_only"], "quality_tier": ["QT4"], "application_method_clear": ["brush"] }, "coats": { "sealer": 1, "clear": 2 }, "notes": "Clear-only brush on natural/pre-stained wood." }
  ],

  "required_paintscope_inputs": [
    { "input_name": "IN_SF_WAINSCOT", "paintscope_key": "PS_SURFACE_SF.WAINSCOTING", "uom": "SF", "required": true },
    { "input_name": "IN_SF_PROTECT_FLOOR_PERIMETER", "paintscope_key": "PS_PROTECT_SF.FLOOR_PERIMETER", "uom": "SF", "required": true },
    { "input_name": "IN_LF_PROTECT_WALL_ABOVE", "paintscope_key": "PS_PROTECT_LF.WALL_ABOVE", "uom": "LF", "required": false, "required_when": "spray or walls SS_PAINTED_*" }
  ],

  "protection_zones_required": [
    { "zone_id": "floor_perimeter", "condition": "always", "protection_level": "edge_only", "notes": "Low height work — drips fall near base." },
    { "zone_id": "wall_above", "condition": { "application_method_stain": ["spray"], "application_method_clear": ["spray"] }, "protection_level": "light_mask", "notes": "Mask wall above cap rail line during spray." }
  ],

  "state_declarations": {
    "primary_surface": "wainscot_panel",
    "valid_input_states": { "states_by_coating_type": { "stain_clear": ["SS_BARE"], "stain_only": ["SS_BARE"], "clear_only": ["SS_BARE", "SS_STAINED"] } },
    "output_state": { "varies_by": "coating_type", "state_map": { "stain_clear": "SS_CLEAR_COATED", "stain_only": "SS_STAINED", "clear_only": "SS_CLEAR_COATED" } }
  },

  "relationships": {

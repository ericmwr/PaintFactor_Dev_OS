  "factor_modifiers": [
    {
      "factor_id": "FAC_RES_CEILING_HEIGHT",
      "description": "Higher ceilings require ladder/scaffold work, reducing productivity.",
      "applies_to_tasks": ["TSK_RES_CUTIN_COAT1", "TSK_RES_CUTIN_COAT2", "TSK_RES_TAPE_APPLY", "TSK_RES_CUT_TO_TAPE_COAT1", "TSK_RES_CUT_TO_TAPE_COAT2"],
      "modifier_type": "multiplier",
      "value_range": [1.0, 1.4],
      "notes": "1.0 for 8-9ft, 1.2 for 10-12ft, 1.4 for vaulted/two-story."
    },
    {
      "factor_id": "FAC_RES_ROOM_COMPLEXITY",
      "description": "Complex room geometry (many corners, returns, openings) reduces edge productivity.",
      "applies_to_tasks": ["TSK_RES_CUTIN_COAT1", "TSK_RES_CUTIN_COAT2", "TSK_RES_TAPE_APPLY", "TSK_RES_CUT_TO_TAPE_COAT1", "TSK_RES_CUT_TO_TAPE_COAT2", "TSK_RES_CAULK_GAPS"],
      "modifier_type": "multiplier",
      "value_range": [1.0, 1.5],
      "notes": "Simple rectangle = 1.0; many windows/doors/returns = 1.3-1.5."
    },
    {
      "factor_id": "FAC_RES_COLOR_CHANGE",
      "description": "Significant color change increases application discipline and potential third coat.",
      "applies_to_tasks": ["TSK_RES_ROLL_COAT1", "TSK_RES_ROLL_COAT2", "TSK_RES_CUTIN_COAT1", "TSK_RES_CUTIN_COAT2"],
      "modifier_type": "multiplier",
      "value_range": [1.0, 1.3],
      "notes": "Light-to-light = 1.0; dark-to-light = 1.2-1.3."
    },
    {
      "factor_id": "FAC_RES_OCCUPIED_HOME",
      "description": "Occupied home increases setup/teardown time and care requirements.",
      "applies_to_tasks": ["TSK_RES_MOVE_FURNITURE", "TSK_RES_PROTECT_FLOORS", "TSK_RES_RESTORE_FURNITURE", "TSK_RES_CLEANUP"],
      "modifier_type": "multiplier",
      "value_range": [1.0, 1.3],
      "notes": "Vacant = 1.0; occupied with furniture = 1.2; occupied with fragile items = 1.3."
    },
    {
      "factor_id": "FAC_RES_TEXTURED_WALLS",
      "description": "Textured walls reduce tape effectiveness and increase cut-in difficulty.",
      "applies_to_tasks": ["TSK_RES_TAPE_APPLY", "TSK_RES_CUTIN_COAT1", "TSK_RES_CUTIN_COAT2"],
      "modifier_type": "multiplier",
      "value_range": [1.0, 1.3],
      "notes": "Smooth = 1.0; light texture = 1.1; heavy texture = 1.2-1.3."
    }
  ],


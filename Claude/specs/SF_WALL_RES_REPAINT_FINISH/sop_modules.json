{
  "spec_family_id": "SF_WALL_RES_REPAINT_FINISH",
  "version": "0.1.0",
  "status": "draft",
  "review_required": true,

  "sop_modules": [
    {
      "module_id": "MOD_RES_PROTECT_SETUP",
      "name": "Residential Protection Setup",
      "purpose": "Protect furniture, floors, and adjacent surfaces in occupied residential space.",
      "applies_to": { "all_variants": true }
    },
    {
      "module_id": "MOD_RES_PREP_GOOD",
      "name": "Wall Prep — Good Condition",
      "purpose": "Light prep for previously painted walls in good condition.",
      "applies_to": { "surface_condition": ["good"] }
    },
    {
      "module_id": "MOD_RES_PREP_FAIR",
      "name": "Wall Prep — Fair Condition",
      "purpose": "Extended prep for walls with moderate wear, repairs needed.",
      "applies_to": { "surface_condition": ["fair"] }
    },
    {
      "module_id": "MOD_RES_SPOT_PRIME",
      "name": "Spot Prime Repairs",
      "purpose": "Prime repairs, stains, and bare spots before finish coats.",
      "applies_to": { "all_variants": true }
    },
    {
      "module_id": "MOD_RES_EDGE_FREEHAND",
      "name": "Edge Strategy — Freehand Cut-in",
      "purpose": "Cut-in edges freehand at ceiling and trim lines.",
      "applies_to": { "edge_strategy": ["cut_in_freehand"] }
    },
    {
      "module_id": "MOD_RES_EDGE_TAPE",
      "name": "Edge Strategy — Tape Line",
      "purpose": "Apply tape, cut to tape line, remove tape for crisp edges.",
      "applies_to": { "edge_strategy": ["tape_line"] }
    },
    {
      "module_id": "MOD_RES_ROLL_FIELD",
      "name": "Roll Wall Field",
      "purpose": "Apply finish coats to wall field using roller.",
      "applies_to": { "application_method": ["roll_only"] }
    },
    {
      "module_id": "MOD_RES_SAND_INSPECT",
      "name": "Sand and Inspect Between Coats",
      "purpose": "Sand and inspect walls between coats per quality tier.",
      "applies_to": { "quality_level": ["QL-3", "QL-4", "QL-5"] }
    },
    {
      "module_id": "MOD_RES_PROTECT_TEARDOWN",
      "name": "Residential Protection Teardown",
      "purpose": "Remove protection, clean up, restore room.",
      "applies_to": { "all_variants": true }
    }
  ],

  "tasks": [
    {
      "task_id": "TSK_RES_MOVE_FURNITURE",

      "round_number": 1,
      "uom": "EA",
      "inputs": ["drop_cloths", "plastic"],
      "outputs": ["furniture_protected"],
      "notes": "Per room; time varies by room contents."
    },
    {
      "task_id": "TSK_RES_PROTECT_FLOORS",
      "module_id": "MOD_RES_PROTECT_SETUP",
      "name": "Lay floor protection",
      "task_type": "protect",
      "round_number": 1,
      "uom": "SF",
      "inputs": ["drop_cloths", "plastic"],
      "outputs": ["floors_protected"],
      "notes": "Canvas drops for main areas; plastic for edges."
    },

    {
      "task_id": "TSK_RES_CLEAN_WALLS",
      "module_id": "MOD_RES_PREP_GOOD",

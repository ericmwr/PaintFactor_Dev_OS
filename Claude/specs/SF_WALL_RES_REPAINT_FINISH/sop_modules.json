  "applicability_rules": [
    {
      "rule_id": "RULE_PREP_BY_CONDITION",
      "description": "Select prep module based on surface condition.",
      "logic": "IF surface_condition = 'good' THEN MOD_RES_PREP_GOOD ELSE MOD_RES_PREP_FAIR"
    },
    {
      "rule_id": "RULE_EDGE_BY_STRATEGY",
      "description": "Select edge module based on edge strategy.",
      "logic": "IF edge_strategy = 'cut_in_freehand' THEN MOD_RES_EDGE_FREEHAND ELSE MOD_RES_EDGE_TAPE"
    },
    {
      "rule_id": "RULE_SAND_BY_QUALITY",
      "description": "Sanding intensity varies by quality level.",
      "logic": "QL-3: spot sand only; QL-4: light full sand; QL-5: full sand with tack"
    }
  ],

  "assumptions": [
    "Edge tasks use LF from PaintScope (ceiling_line_lf + trim_line_lf + opening_casing_lf).",
    "Field tasks use SF from PaintScope (wall_sf).",
    "Protection setup/teardown is per-room fixed time plus SF-based floor coverage.",
    "Prep module selection is mutually exclusive: good OR fair, not both."
  ],

  "exclusions": [
    "Ceiling painting (separate spec).",
    "Trim painting (separate spec).",
    "Major drywall repair beyond spackle/caulk.",
    "Lead paint abatement.",
    "Wallpaper removal."
  ]
}

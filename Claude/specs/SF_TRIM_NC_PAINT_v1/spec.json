{
  "spec_family": {
    "id": "SF_TRIM_NC_PAINT",
    "name": "New Construction Trim Paint - Baseboard, Window/Door Casing",
    "description": "Finish coat application (2 coats) for pre-primed interior trim in new construction. Covers baseboard, door casing, and window casing. All trim same color and sheen. Full prep per Fine Finish Doctrine including fastener hole filling, open grain treatment, sanding, and caulking.",
    "domain": "interior",
    "version": "0.1.0",
    "status": "draft",
    "review_required": true,
    "doctrine_alignment": "Fine_Finish_Doctrine.md v1.0"
  },

  "scope_boundaries": {
    "includes": [
      "Pre-primed baseboard (factory primer)",
      "Pre-primed door casing (factory primer)",
      "Pre-primed window casing (factory primer)",
      "Fastener hole filling (2 stacked holes every 12-16 inches standard)",
      "Open grain filling at exposed casing ends (2 per door, 4 per window)",
      "Full surface sanding for adhesion",
      "Caulking at trim-to-wall joints (baseboard and casing treated separately)",
      "Two finish coats with interstage process",
      "Floor protection when required"
    ],
    "excludes": [
      "Crown molding (see SF_CROWN_NC_PAINT)",
      "Door slabs (see SF_DOOR_NC_PAINT)",
      "Door jambs (see SF_JAMB_NC_PAINT or include with door spec)",
      "Bare wood trim requiring primer (see SF_TRIM_NC_PRIME_PAINT)",
      "Stained/cleared trim",
      "Chair rail, picture rail, other specialty trim",
      "Exterior trim"
    ]
  },

  "configuration_dimensions": [
    {
      "dimension_id": "quality_tier",
      "description": "Quality tier per Fine Finish Doctrine. Sheen restricts minimum QT.",
      "values": ["QT3", "QT4", "QT5"],
      "default": "QT4",
      "notes": "QT3=satin max; QT4=semi-gloss allowed; QT5=any sheen including gloss"
    },
    {
      "dimension_id": "application_method",
      "description": "Application technique. Spray is standard for NC production.",
      "values": ["spray", "brush"],
      "default": "spray",
      "notes": "Per Fine Finish Doctrine: QT4+ prefers spray"
    },
    {
      "dimension_id": "sheen",
      "description": "Finish sheen. Higher sheens require higher quality tiers per doctrine.",
      "values": ["satin", "semi-gloss", "gloss"],
      "default": "semi-gloss",
      "notes": "Semi-gloss typical for trim. Gloss requires QT5."
    },
    {
      "dimension_id": "condition_class",
      "description": "Trim installation condition. Affects prep time estimation.",
      "values": ["Good", "Fair", "Poor"],
      "default": "Good",
      "notes": "Estimator assigns based on overall defect assessment"
    },
    {
      "dimension_id": "coat_count",
      "description": "Number of finish coats",
      "values": ["2"],
      "default": "2",
      "notes": "2 coats standard per Fine Finish Doctrine"
    }
  ],

  "quality_sheen_rules": {
    "description": "Per Fine_Finish_Doctrine.md - Sheen Selection",
    "rules": [
      {
        "sheen": ["satin"],
        "minimum_quality_tier": "QT3"
      },
      {
        "sheen": ["semi-gloss"],
        "minimum_quality_tier": "QT4"
      },
      {
        "sheen": ["gloss"],
        "minimum_quality_tier": "QT5"
      }
    ],
    "auto_upgrade": "If sheen requires higher QT than specified, auto-upgrade QT"
  },

  "paintable_items": [
    {
      "item_id": "ITM_BASEBOARD",
      "name": "Baseboard",
      "unit_of_measure": "LF",
      "counting_rules": "Source from PS_SURFACE_LF.TRIM_BASEBOARD"
    },
    {
      "item_id": "ITM_DOOR_CASING",
      "name": "Door Casing",
      "unit_of_measure": "LF",
      "counting_rules": "Source from PS_SURFACE_LF.TRIM_CASING_DOOR. Door openings counted per SIDE: 1 interior door = 2 sides (2 casing sets), 1 exterior door = 1 interior side (1 casing set)."
    },
    {
      "item_id": "ITM_WINDOW_CASING",
      "name": "Window Casing",
      "unit_of_measure": "LF",
      "counting_rules": "Source from PS_SURFACE_LF.TRIM_CASING_WINDOW"
    },
    {
      "item_id": "ITM_OPEN_GRAIN_ENDS",
      "name": "Open Grain Casing Ends",
      "unit_of_measure": "EA",
      "counting_rules": "Calculated: (Door openings x 2) + (Window openings x 4)",
      "notes": "Derived from door and window opening counts"
    },
    {
      "item_id": "ITM_FLOOR_PROTECTION",
      "name": "Floor Protection",
      "unit_of_measure": "SF",
      "counting_rules": "Source from PS_PROTECT_SF.FLOOR_EXPOSED",
      "notes": "Required when spray application method selected"
    }
  ],

  "variants": [
    {
      "variant_id": "VAR_SPRAY_QT3_SATIN",
      "applies_when": {
        "quality_tier": ["QT3"],
        "application_method": ["spray"],
        "sheen": ["satin"]
      },
      "included_items": ["ITM_BASEBOARD", "ITM_DOOR_CASING", "ITM_WINDOW_CASING", "ITM_OPEN_GRAIN_ENDS", "ITM_FLOOR_PROTECTION"],
      "notes": "Standard NC trim - satin sheen, spray application"
    },
    {
      "variant_id": "VAR_SPRAY_QT4_SEMIGLOSS",
      "applies_when": {
        "quality_tier": ["QT4"],
        "application_method": ["spray"],
        "sheen": ["semi-gloss"]
      },
      "included_items": ["ITM_BASEBOARD", "ITM_DOOR_CASING", "ITM_WINDOW_CASING", "ITM_OPEN_GRAIN_ENDS", "ITM_FLOOR_PROTECTION"],
      "notes": "Premium NC trim - semi-gloss, spray application"
    },
    {
      "variant_id": "VAR_SPRAY_QT5_GLOSS",
      "applies_when": {
        "quality_tier": ["QT5"],
        "application_method": ["spray"],
        "sheen": ["gloss"]
      },
      "included_items": ["ITM_BASEBOARD", "ITM_DOOR_CASING", "ITM_WINDOW_CASING", "ITM_OPEN_GRAIN_ENDS", "ITM_FLOOR_PROTECTION"],
      "notes": "Superior NC trim - gloss sheen, zero tolerance"
    },
    {
      "variant_id": "VAR_BRUSH_QT3_SATIN",
      "applies_when": {
        "quality_tier": ["QT3"],
        "application_method": ["brush"],
        "sheen": ["satin"]
      },
      "included_items": ["ITM_BASEBOARD", "ITM_DOOR_CASING", "ITM_WINDOW_CASING", "ITM_OPEN_GRAIN_ENDS", "ITM_FLOOR_PROTECTION"],
      "notes": "Brush application - floor protection recommended (drop cloth moved along with work if not already in place)"
    },
    {
      "variant_id": "VAR_BRUSH_QT4_SEMIGLOSS",
      "applies_when": {
        "quality_tier": ["QT4"],
        "application_method": ["brush"],
        "sheen": ["semi-gloss"]
      },
      "included_items": ["ITM_BASEBOARD", "ITM_DOOR_CASING", "ITM_WINDOW_CASING", "ITM_OPEN_GRAIN_ENDS", "ITM_FLOOR_PROTECTION"],
      "notes": "Premium brush work - floor protection recommended"
    }
  ],

  "required_paintscope_inputs": [
    {
      "input_name": "IN_LF_BASEBOARD",
      "paintscope_key": "PS_SURFACE_LF.TRIM_BASEBOARD",
      "uom": "LF",
      "required": true,
      "description": "Baseboard linear footage"
    },
    {
      "input_name": "IN_LF_DOOR_CASING",
      "paintscope_key": "PS_SURFACE_LF.TRIM_CASING_DOOR",
      "uom": "LF",
      "required": true,
      "description": "Door casing linear footage"
    },
    {
      "input_name": "IN_LF_WINDOW_CASING",
      "paintscope_key": "PS_SURFACE_LF.TRIM_CASING_WINDOW",
      "uom": "LF",
      "required": true,
      "description": "Window casing linear footage"
    },
    {
      "input_name": "IN_EA_DOOR_OPENINGS",
      "paintscope_key": "PS_OPENING_EA.DOOR_OPENINGS_TOTAL",
      "uom": "EA",
      "required": true,
      "description": "Door opening count for open grain fill calculation (2 ends per opening side). Counted per SIDE: interior door = 2 sides, exterior door = 1 interior side."
    },
    {
      "input_name": "IN_EA_WINDOW_OPENINGS",
      "paintscope_key": "PS_OPENING_EA.WINDOW_OPENINGS_TOTAL",
      "uom": "EA",
      "required": true,
      "description": "Window opening count for open grain fill calculation (4 ends per opening)"
    },
    {
      "input_name": "IN_SF_PROTECT_FLOOR_EXPOSED",
      "paintscope_key": "PS_PROTECT_SF.FLOOR_EXPOSED",
      "uom": "SF",
      "required": false,
      "required_when": {
        "condition": "application_method = 'spray'"
      },
      "description": "Floor protection area for spray application"
    }
  ],

  "protection_zones_required": [
    {
      "zone_id": "floor_perimeter",
      "condition": "always",
      "protection_level": "edge_only",
      "upgrades_to_zone": "floor_full",
      "upgrades_to_level": "full_cover",
      "upgrade_condition": { "application_method": "spray" }
    }
  ],

  "adjacency_declarations": {
    "primary_surface": "trim_baseboard",
    "adjacent_surfaces": [
      {
        "surface_id": "wall_field",
        "edge_type": "linear",
        "typical_relationship": "different_finish",
        "continuity_rate_modifier": 1.20,
        "affected_tasks": ["TSK_TRIM_CAULK_BASEBOARD", "TSK_TRIM_CAULK_CASING"]
      }
    ]
  },

  "relationships": {
    "often_combined_with": [
      "SF_DOOR_NC_PAINT",
      "SF_JAMB_NC_PAINT",
      "SF_CROWN_NC_PAINT"
    ],
    "sequencing": {
      "typical_before": ["SF_DRYWALL_WALL_NC_FINISH"],
      "typical_after": ["SF_DRYWALL_WALL_NC_PRIME", "SF_DRYWALL_CEILINGS_NC_PAINT"]
    },
    "notes": "NC trim typically painted after ceiling finish but before wall finish coats"
  },

  "dependencies": {
    "research": "research.json",
    "materials": "materials.json",
    "sop_modules": "sop_modules.json",
    "production": "production.json"
  },


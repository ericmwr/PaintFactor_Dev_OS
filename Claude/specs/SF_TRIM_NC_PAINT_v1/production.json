  "factor_modifiers": {
    "condition_modifiers": {
      "description": "Trim condition at installation affects prep task production. Per research: condition class is heuristic for overall defect intensity.",
      "applies_to_task_types": ["fill_fasteners", "caulk_joints", "sand_filled", "fill_open_grain"],
      "values": [
        {
          "condition": "Good",
          "modifier": 1.0,
          "notes": "Standard NC installation quality"
        },
        {
          "condition": "Fair",
          "modifier": 1.5,
          "notes": "Below-average installation, more defects"
        },
        {
          "condition": "Poor",
          "modifier": 2.0,
          "notes": "Poor installation, consider flagging or hourly billing"
        }
      ]
    },

    "profile_complexity_modifiers": {
      "description": "Trim profile complexity affects application and sanding rates",
      "applies_to_task_types": ["spray_finish", "brush_finish", "full_sand", "light_sand"],
      "values": [
        {
          "condition": "profile_complexity = 'flat_stock'",
          "modifier": 0.9,
          "notes": "Flat stock trim is faster"
        },
        {
          "condition": "profile_complexity = 'standard'",
          "modifier": 1.0,
          "notes": "Standard 3-4 inch colonial/clamshell profile"
        },
        {
          "condition": "profile_complexity = 'detailed'",
          "modifier": 1.25,
          "notes": "Detailed profiles with multiple curves, reveals"
        }
      ]
    },

    "height_modifiers": {
      "description": "Ceiling height affects productivity for tall door/window casings",
      "applies_to_task_types": ["spray_finish", "brush_finish", "caulk_joints"],
      "values": [
        {
          "condition": "ceiling_height_ft <= 9",
          "modifier": 1.0,
          "notes": "Standard residential height"
        },
        {
          "condition": "ceiling_height_ft >= 10 AND ceiling_height_ft <= 12",
          "modifier": 1.15,
          "notes": "Ladder required for upper casing"
        },
        {
          "condition": "ceiling_height_ft >= 13 AND ceiling_height_ft <= 17",
          "modifier": 1.3,
          "notes": "Extension ladder or scaffold required"
        },
        {
          "condition": "ceiling_height_ft >= 18",
          "modifier": 1.5,
          "notes": "Scaffold or lift required"
        }
      ]
    }
  },


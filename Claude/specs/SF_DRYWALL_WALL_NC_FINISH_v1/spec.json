{
  "spec_family": {
    "id": "SF_DRYWALL_WALL_NC_FINISH",
    "name": "New Construction Drywall Wall Finish Coat",
    "description": "Finish coat application (typically 2 coats) for primed drywall wall surfaces in new construction. Applied over cured primer. Does NOT include primer, ceiling, or trim finish.",
    "domain": "interior",
    "version": "0.1.0",
    "status": "draft",
    "review_required": true
  },

  "scope_boundaries": {
    "includes": [
      "Primed drywall wall surfaces (primer cured)",
      "Finish coat application (1 or 2 coats)",
      "Surface preparation (inspection, dust wipe, sanding per QT)",
      "Edge cut-in at ceiling and trim",
      "Floor protection when required"
    ],
    "excludes": [
      "Primer application (see SF_DRYWALL_WALL_NC_PRIME)",
      "Ceiling finish",
      "Trim finish",
      "Drywall repair",
      "Texture application"
    ]
  },

  "configuration_dimensions": [
    {
      "dimension_id": "quality_tier",
      "description": "Quality tier per doctrine. Note: Sheen restricts minimum QT.",
      "values": ["QT2", "QT3", "QT4", "QT5"],
      "default": "QT3",
      "notes": "QT2=flat/matte only; QT3=eggshell max; QT4+ for satin/semi-gloss per doctrine"
    },
    {
      "dimension_id": "application_method",
      "description": "Application technique. Spray+backroll uses 18-inch roller per doctrine.",
      "values": ["roll", "spray_backroll", "spray"],
      "default": "spray_backroll"
    },
    {
      "dimension_id": "sheen",
      "description": "Finish sheen. Higher sheens auto-upgrade quality tier per doctrine.",
      "values": ["flat", "matte", "eggshell", "satin", "semi-gloss"],
      "default": "eggshell",
      "notes": "Satin/semi-gloss require QT4+ per doctrine"
    },
    {
      "dimension_id": "surface_texture",
      "description": "Wall surface texture",
      "values": ["smooth", "orange_peel", "knockdown"],
      "default": "smooth"
    },
    {
      "dimension_id": "coat_count",
      "description": "Number of finish coats",
      "values": ["1", "2"],
      "default": "2",
      "notes": "1 coat for QT2 economy only"
    }
  ],

  "quality_sheen_rules": {
    "description": "Per Quality_Tiers_and_Surface_Condition.md v1.1",
    "rules": [
      {
        "sheen": ["flat", "matte"],
        "minimum_quality_tier": "QT2"
      },
      {
        "sheen": ["eggshell"],
        "minimum_quality_tier": "QT3"
      },
      {
        "sheen": ["satin", "semi-gloss"],
        "minimum_quality_tier": "QT4"
      }
    ],
    "auto_upgrade": "If sheen requires higher QT than specified, auto-upgrade QT"
  },

  "sanding_requirements": {
    "description": "Per Quality_Tiers_and_Surface_Condition.md v1.1",
    "by_tier": {
      "QT2": {
        "prime_to_finish": "None",
        "between_finish_coats": "None"
      },
      "QT3": {
        "prime_to_finish": "Light sand 120 grit",
        "between_finish_coats": "Spot sand patches only"
      },
      "QT4": {
        "prime_to_finish": "Full sand",
        "between_finish_coats": "Full sand 220 grit"
      },
      "QT5": {
        "prime_to_finish": "Full sand",
        "between_finish_coats": "Full sand 220 grit"
      }
    }
  },

  "paintable_items": [
    {
      "item_id": "ITM_WALL_FIELD_FINISH",
      "name": "Wall Field Finish Coat",
      "unit_of_measure": "SF",
      "counting_rules": "Source from PS_SURFACE_SF.WALL_FIELD"
    },
    {
      "item_id": "ITM_EDGE_CEILING_FINISH",
      "name": "Ceiling Edge Cut-In",
      "unit_of_measure": "LF",
      "counting_rules": "Source from PS_EDGE_LF.TO_CEILING"
    },
    {
      "item_id": "ITM_EDGE_TRIM_FINISH",
      "name": "Trim Edge Cut-In",
      "unit_of_measure": "LF",
      "counting_rules": "Source from PS_EDGE_LF.TO_TRIM",
      "notes": "Required when trim is installed"
    },
    {
      "item_id": "ITM_FLOOR_PROTECTION",
      "name": "Floor Protection",
      "unit_of_measure": "SF",
      "counting_rules": "Source from PS_PROTECT_SF.FLOOR_EXPOSED",
      "notes": "Required when finished flooring installed"
    }
  ],

  "variants": [
    {
      "variant_id": "VAR_ROLL_QT2_1COAT",
      "applies_when": {
        "quality_tier": ["QT2"],
        "application_method": ["roll"],
        "coat_count": ["1"],
        "sheen": ["flat", "matte"]
      },
      "included_items": ["ITM_WALL_FIELD_FINISH"],
      "notes": "Economy single coat - flat/matte only per doctrine"
    },
    {
      "variant_id": "VAR_ROLL_QT3_2COAT",
      "applies_when": {
        "quality_tier": ["QT3"],
        "application_method": ["roll"],
        "coat_count": ["2"],
        "sheen": ["flat", "matte", "eggshell"]
      },
      "included_items": ["ITM_WALL_FIELD_FINISH", "ITM_EDGE_CEILING_FINISH"],
      "notes": "Standard 2-coat roller - eggshell max per doctrine"
    },
    {
      "variant_id": "VAR_ROLL_QT4_2COAT",
      "applies_when": {
        "quality_tier": ["QT4"],
        "application_method": ["roll"],
        "coat_count": ["2"]
      },
      "included_items": ["ITM_WALL_FIELD_FINISH", "ITM_EDGE_CEILING_FINISH", "ITM_EDGE_TRIM_FINISH"],
      "notes": "Premium roller with sanding - any sheen allowed"
    },
    {
      "variant_id": "VAR_SPRAY_BACKROLL_QT3_2COAT",
      "applies_when": {
        "quality_tier": ["QT3"],
        "application_method": ["spray_backroll"],
        "coat_count": ["2"],
        "sheen": ["flat", "matte", "eggshell"]
      },
      "included_items": ["ITM_WALL_FIELD_FINISH", "ITM_EDGE_CEILING_FINISH"],
      "notes": "Standard spray+backroll (18\" roller) - eggshell max per doctrine"
    },
    {
      "variant_id": "VAR_SPRAY_BACKROLL_QT4_2COAT",
      "applies_when": {
        "quality_tier": ["QT4"],
        "application_method": ["spray_backroll"],
        "coat_count": ["2"]
      },
      "included_items": ["ITM_WALL_FIELD_FINISH", "ITM_EDGE_CEILING_FINISH", "ITM_EDGE_TRIM_FINISH"],
      "notes": "Premium spray+backroll (18\" roller) - any sheen allowed"
    },
    {
      "variant_id": "VAR_SPRAY_BACKROLL_QT5_2COAT",
      "applies_when": {
        "quality_tier": ["QT5"],
        "application_method": ["spray_backroll"],
        "coat_count": ["2"]
      },
      "included_items": ["ITM_WALL_FIELD_FINISH", "ITM_EDGE_CEILING_FINISH", "ITM_EDGE_TRIM_FINISH", "ITM_FLOOR_PROTECTION"],
      "notes": "Superior spray+backroll with full protection"
    }
  ],

  "required_paintscope_inputs": [
    {
      "input_name": "IN_SF_WALL_FIELD",
      "paintscope_key": "PS_SURFACE_SF.WALL_FIELD",
      "uom": "SF",
      "required": true,
      "description": "Total paintable wall field area"
    },
    {
      "input_name": "IN_LF_EDGE_TO_CEILING",
      "paintscope_key": "PS_EDGE_LF.TO_CEILING",
      "uom": "LF",
      "required": true,
      "required_when": {
        "quality_tier": ["QT3", "QT4", "QT5"]
      },
      "description": "Wall-to-ceiling edge"
    },
    {
      "input_name": "IN_LF_EDGE_TO_TRIM",
      "paintscope_key": "PS_EDGE_LF.TO_TRIM",
      "uom": "LF",
      "required": false,
      "required_when": {
        "condition": "trim_installed = true"
      },
      "description": "Wall-to-trim edges"
    },
    {
      "input_name": "IN_SF_PROTECT_FLOOR_EXPOSED",
      "paintscope_key": "PS_PROTECT_SF.FLOOR_EXPOSED",
      "uom": "SF",
      "required": false,
      "required_when": {
        "condition": "finished_flooring_installed = true"
      },
      "description": "Floor protection area"
    }
  ],

  "relationships": {
    "follows": ["SF_DRYWALL_WALL_NC_PRIME"],
    "may_combine_with": ["SF_DRYWALL_WALL_NC_FULL"],
    "interacts_with": ["SF_TRIM_INT_NC_FINISH", "SF_CEILING_INT_NC_FINISH"]
  },

  "dependencies": {
    "materials": "materials.json",
    "sop_modules": "sop_modules.json",
    "production": "production.json"
  },

  "doctrine_references": [
    {
      "doctrine": "Quality_Tiers_and_Surface_Condition.md",
      "version": "1.1",
      "sections_used": ["Sanding Standards by Quality Tier", "Sheen and Quality Tier Minimums"]
    },
    {
      "doctrine": "Materials_and_Consumables_Doctrine.md",
      "version": "1.1",
      "sections_used": ["Spray + Backroll Roller Standard"]
    },
    {
      "doctrine": "Estimation_Modifiers_Doctrine.md",
      "version": "1.1",
      "sections_used": ["Spray/Backroll Throughput Coupling"]
    }
  ],

  "change_log": [
    {
      "version": "0.1.0",
      "date": "2026-01-24",
      "author": "SpecFactory",
      "changes": "Initial draft incorporating updated doctrine (sanding standards, sheen/QT rules, 18\" roller)"
    }
  ]
}

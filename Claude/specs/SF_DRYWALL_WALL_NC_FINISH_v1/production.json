  "factor_modifiers": {
    "height_modifiers": {
      "description": "Ceiling height affects productivity. Per Estimation_Modifiers_Doctrine.md.",
      "applies_to_task_types": ["cut_in", "roll", "spray", "backroll"],
      "values": [
        {
          "condition": "ceiling_height_ft <= 8",
          "modifier": 1.0,
          "notes": "Baseline - standard residential"
        },
        {
          "condition": "ceiling_height_ft >= 9 AND ceiling_height_ft <= 12",
          "modifier": 1.3,
          "notes": "Step ladder required"
        },
        {
          "condition": "ceiling_height_ft >= 13 AND ceiling_height_ft <= 17",
          "modifier": 1.5,
          "notes": "Extension ladder or scaffold required"
        },
        {
          "condition": "ceiling_height_ft >= 18",
          "modifier": 2.0,
          "notes": "Scaffold or lift required"
        }
      ]
    },

    "complexity_modifiers": {
      "description": "Room complexity affects cut-in and masking. Per Estimation_Modifiers_Doctrine.md.",
      "applies_to_task_types": ["cut_in", "mask"],
      "values": [
        {
          "condition": "room_type = 'bathroom' AND hardware_installed = true",
          "modifier": 2.0,
          "notes": "Fixtures, mirrors, tight spaces"
        },
        {
          "condition": "cabinets_present = true",
          "modifier": 1.5,
          "notes": "Cabinet edges, masking"
        },
        {
          "condition": "fireplace_present = true",
          "modifier": 1.3,
          "notes": "Mantle, surround detail"
        },
        {
          "condition": "closet_shelving_present = true",
          "modifier": 1.5,
          "notes": "Per PS_ROOM_FLAG.CLOSET_SHELVING_PRESENT"
        }
      ]
    },

    "color_change_modifiers": {
      "description": "Color change difficulty. Per Estimation_Modifiers_Doctrine.md. Note: For NC over fresh primer, this typically applies when primer was tinted differently than finish.",
      "applies_to_task_types": ["roll", "spray", "backroll", "cut_in"],
      "values": [
        {
          "condition": "color_change = 'none' OR color_change = 'light_to_light'",
          "modifier": 1.0,
          "notes": "No difficulty increase"
        },
        {
          "condition": "color_change = 'light_to_dark'",
          "modifier": 1.1,
          "notes": "Slight coverage challenge - consider tinted primer"
        },
        {
          "condition": "color_change = 'high_contrast'",
          "modifier": 1.3,
          "notes": "Extra care at edges"
        }
      ],
      "nc_note": "For NC, color change is typically 'none' since primer is fresh. Use color_change modifiers when primer color differs significantly from finish."
    },

    "texture_modifiers": {
      "description": "Surface texture affects application. Per Estimation_Modifiers_Doctrine.md.",
      "applies_to_task_types": ["roll", "spray", "backroll", "cut_in", "mask"],
      "values": [
        {
          "condition": "surface_texture = 'smooth'",
          "modifier": 1.0,
          "notes": "Baseline"
        },
        {
          "condition": "surface_texture = 'orange_peel'",
          "modifier": 1.1,
          "notes": "Light texture - slight coverage increase"
        },
        {
          "condition": "surface_texture = 'knockdown'",
          "modifier": 1.15,
          "notes": "Moderate texture"
        },
        {
          "condition": "surface_texture = 'heavy_texture'",
          "modifier": 1.25,
          "notes": "Significant pace reduction"
        }
      ]
    }
  },

  "quality_tier_effects": [
    {
      "quality_tier": "QT2",
      "time_modifier": 0.75,
      "description": "Economy finish - no sanding, single coat acceptable",
      "mechanism": "baseline_reduction",
      "max_sheen": "matte",
      "notes": "Per doctrine: QT2 max sheen = flat or matte"
    },
    {
      "quality_tier": "QT3",
      "time_modifier": 1.0,
      "description": "Standard finish - light sand primer, 2 coats",
      "mechanism": "baseline",
      "max_sheen": "eggshell",
      "notes": "Per doctrine: QT3 max sheen = eggshell"
    },
    {
      "quality_tier": "QT4",
      "time_modifier": 1.3,
      "description": "Premium finish - full sand, sand between coats",
      "mechanism": "selective_multiplier",
      "max_sheen": "any",
      "notes": "Per doctrine: QT4+ required for satin/semi-gloss/gloss"
    },
    {
      "quality_tier": "QT5",
      "time_modifier": 1.5,
      "description": "Superior finish - maximum care throughout",
      "mechanism": "selective_multiplier",
      "condition_gate": "Good condition only",
      "max_sheen": "any",
      "notes": "Per doctrine: Fair/Poor requires hourly billing"
    }
  ],


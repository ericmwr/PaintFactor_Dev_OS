      "applies_when": {
        "quality_tier": ["QT2", "QT3", "QT4", "QT5"]
      },
      "required_inputs": [
        {
          "input_name": "IN_SF_WALL_FIELD",
          "paintscope_key": "PS_SURFACE_SF.WALL_FIELD",
          "uom": "SF"
        }
      ],
      "tasks": [
        {
          "task_id": "TSK_INSPECT_PRIMER",
          "name": "Inspect Primer Coat",
          "description": "Walk primed surfaces with work light. Check for holidays, sags, dust nibs.",
          "task_classification": "binary",
          "skill_level": "journeyman",
          "tools_required": ["work_light", "marking_crayon"],
          "quality_notes": {
            "QT2": "Check for major defects only",
            "QT3": "Inspect for all visible defects",
            "QT4": "Thorough inspection, mark all imperfections",
            "QT5": "Meticulous inspection with raking light"
          }
        },
        {
          "task_id": "TSK_INSPECT_PRIMER_QT4",
          "name": "Inspect Primer Coat (Premium)",
          "description": "Thorough inspection of primed surface using raking light. Identify all imperfections, texture inconsistencies, and coverage issues. QT4/QT5 requires comprehensive defect identification before finish coats.",
          "task_classification": "binary",
          "skill_level": "journeyman",
          "tools_required": ["work_light", "marking_crayon"],
          "quality_notes": {
            "QT4": "Detailed inspection with raking light, mark all imperfections",
            "QT5": "Critical inspection - semi-gloss+ finish shows everything"
          }
        },
        {

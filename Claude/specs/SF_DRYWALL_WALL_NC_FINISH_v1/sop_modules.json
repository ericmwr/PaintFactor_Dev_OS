          "uom": "SF"
        },
        {
          "input_name": "IN_LF_EDGE_TO_CEILING",
          "paintscope_key": "PS_EDGE_LF.TO_CEILING",
          "uom": "LF"
        }
      ],
      "tasks": [
        {
          "task_id": "TSK_CUT_IN_CEILING_SECOND",
          "name": "Cut-In Ceiling (Second Coat)",

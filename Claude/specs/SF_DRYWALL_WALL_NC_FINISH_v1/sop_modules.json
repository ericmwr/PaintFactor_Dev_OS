{
  "spec_family_id": "SF_DRYWALL_WALL_NC_FINISH",
  "version": "0.1.0",

  "sop_modules": [
    {
      "module_id": "MOD_PREP_PRIMED_SURFACE",
      "name": "Prepare Primed Surface",
      "description": "Prepare primed drywall for finish coats. Sanding requirements per Quality Tiers doctrine.",
      "phase": "prep",
      "applies_when": {
        "quality_tier": ["QT2", "QT3", "QT4", "QT5"]
      },
      "required_inputs": [
        {
          "input_name": "IN_SF_WALL_FIELD",
          "paintscope_key": "PS_SURFACE_SF.WALL_FIELD",
          "uom": "SF"
        }
      ],
      "tasks": [
        {
          "task_id": "TSK_INSPECT_PRIMER",
          "name": "Inspect Primer Coat",
          "description": "Walk primed surfaces with work light. Check for holidays, sags, dust nibs.",
          "skill_level": "journeyman",
          "tools_required": ["work_light", "marking_crayon"],
          "quality_notes": {
            "QT2": "Check for major defects only",
            "QT3": "Inspect for all visible defects",
            "QT4": "Thorough inspection, mark all imperfections",
            "QT5": "Meticulous inspection with raking light"
          }
        },
        {
          "task_id": "TSK_DUST_WIPE",
          "name": "Dust Wipe Surfaces",
          "description": "Remove construction dust using tack cloth.",
          "skill_level": "helper",
          "tools_required": ["tack_cloth"],
          "quality_notes": {
            "QT2": "Spot check only",
            "QT3": "Wipe all surfaces",
            "QT4": "Thorough wipe",
            "QT5": "Complete dust removal"
          }
        },
        {
          "task_id": "TSK_TOUCH_UP_PRIMER",
          "name": "Touch Up Primer Defects",
          "description": "Spot-prime holidays or defects found during inspection.",
          "skill_level": "journeyman",
          "tools_required": ["brush_2in", "primer"],
          "conditional_on": "defects_found"
        }
      ],
      "sequence_notes": "Inspect → Touch-up → Dust wipe"
    },
    {
      "module_id": "MOD_SAND_PRIMER_QT3",
      "name": "Light Sand Primer (QT3)",
      "description": "Light sand with 120 grit per doctrine for QT3.",
      "phase": "prep",
      "applies_when": {
        "quality_tier": ["QT3"]
      },
      "required_inputs": [
        {
          "input_name": "IN_SF_WALL_FIELD",
          "paintscope_key": "PS_SURFACE_SF.WALL_FIELD",
          "uom": "SF"
        }
      ],
      "tasks": [
        {
          "task_id": "TSK_LIGHT_SAND_PRIMER",
          "name": "Light Sand Primer",
          "description": "Light sand primed surface with 120 grit for adhesion.",
          "skill_level": "journeyman",
          "tools_required": ["sanding_block_120", "pole_sander", "dust_mask"]
        },
        {
          "task_id": "TSK_VACUUM_SAND_DUST_QT3",
          "name": "Remove Sanding Dust",
          "description": "Vacuum and tack wipe after sanding.",
          "skill_level": "helper",
          "tools_required": ["vacuum", "tack_cloth"]
        }
      ],
      "sequence_notes": "Light sand → Vacuum → Tack wipe"
    },
    {
      "module_id": "MOD_SAND_PRIMER_QT4",
      "name": "Full Sand Primer (QT4/QT5)",
      "description": "Full sand with 120-150 grit per doctrine for QT4/QT5.",
      "phase": "prep",
      "applies_when": {
        "quality_tier": ["QT4", "QT5"]
      },
      "required_inputs": [
        {
          "input_name": "IN_SF_WALL_FIELD",
          "paintscope_key": "PS_SURFACE_SF.WALL_FIELD",
          "uom": "SF"
        }
      ],
      "tasks": [
        {
          "task_id": "TSK_FULL_SAND_PRIMER",
          "name": "Full Sand Primer",
          "description": "Full sand entire primed surface with 120-150 grit.",
          "skill_level": "journeyman",
          "tools_required": ["pole_sander", "sanding_block", "dust_mask"]
        },
        {
          "task_id": "TSK_VACUUM_SAND_DUST_QT4",
          "name": "Remove Sanding Dust",
          "description": "Thorough vacuum and tack wipe after sanding.",
          "skill_level": "helper",
          "tools_required": ["vacuum", "tack_cloth"]
        }
      ],
      "sequence_notes": "Full sand → Vacuum → Tack wipe"
    },
    {
      "module_id": "MOD_PROTECT_FLOORS",
      "name": "Protect Finished Floors",
      "description": "Protect flooring during painting when installed.",
      "phase": "prep",
      "applies_when": {},
      "required_inputs": [
        {
          "input_name": "IN_SF_PROTECT_FLOOR_EXPOSED",
          "paintscope_key": "PS_PROTECT_SF.FLOOR_EXPOSED",
          "uom": "SF"
        }
      ],
      "tasks": [
        {
          "task_id": "TSK_LAY_DROP_CLOTHS",
          "name": "Lay Drop Cloths",
          "description": "Cover flooring with canvas drop cloths.",
          "skill_level": "helper",
          "tools_required": ["drop_cloths", "masking_tape"]
        }
      ]
    },
    {
      "module_id": "MOD_APPLY_FINISH_ROLL_FIRST",
      "name": "Apply First Finish Coat - Roller",
      "description": "Apply first coat using 9-inch roller.",
      "phase": "apply",
      "applies_when": {
        "application_method": ["roll"]
      },
      "required_inputs": [
        {
          "input_name": "IN_SF_WALL_FIELD",
          "paintscope_key": "PS_SURFACE_SF.WALL_FIELD",
          "uom": "SF"
        },
        {
          "input_name": "IN_LF_EDGE_TO_CEILING",
          "paintscope_key": "PS_EDGE_LF.TO_CEILING",
          "uom": "LF"
        }
      ],
      "tasks": [
        {
          "task_id": "TSK_CUT_IN_CEILING_FIRST",
          "name": "Cut-In Ceiling Edge",
          "description": "Brush-cut finish along ceiling line.",
          "skill_level": "journeyman",
          "tools_required": ["brush_2.5in_angled", "cut_bucket"],
          "quality_notes": {
            "QT2": "Acceptable edge",
            "QT3": "Clean edge",
            "QT4": "Crisp straight edge",
            "QT5": "Perfect straight line"
          }
        },
        {
          "task_id": "TSK_CUT_IN_TRIM_FIRST",
          "name": "Cut-In Trim Edge",
          "description": "Brush-cut finish along trim when installed.",
          "skill_level": "journeyman",
          "tools_required": ["brush_2.5in_angled", "cut_bucket"],
          "conditional_on": "trim_installed"
        },
        {
          "task_id": "TSK_ROLL_FIRST_COAT",
          "name": "Roll First Finish Coat",
          "description": "Apply first coat with 9-inch roller.",
          "skill_level": "journeyman",
          "tools_required": ["roller_9in", "roller_cover", "extension_pole", "bucket"]
        }
      ],
      "sequence_notes": "Cut ceiling → Cut trim → Roll field"
    },
    {
      "module_id": "MOD_APPLY_FINISH_ROLL_SECOND",

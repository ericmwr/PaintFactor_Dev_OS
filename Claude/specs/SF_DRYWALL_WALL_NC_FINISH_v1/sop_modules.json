          "tools_required": ["roller_18in", "roller_cover_18in", "extension_pole"]
        },
        {
          "task_id": "TSK_CUT_IN_TOUCH_FIRST",
          "name": "Touch-Up Cut Lines",
          "description": "Touch up edges after removing mask.",

          "tools_required": ["masking_tape", "masking_paper", "plastic_drop"]
        },
        {
          "task_id": "TSK_SPRAY_FIRST_COAT",
          "name": "Spray First Finish Coat",
          "description": "Apply first coat via airless sprayer.",
          "skill_level": "journeyman",
          "tools_required": ["airless_sprayer", "spray_tip_515", "respirator"]
        },
        {
          "task_id": "TSK_BACKROLL_FIRST_COAT",
          "name": "Backroll First Coat",
          "description": "Immediately follow spray with 18-inch roller per doctrine.",

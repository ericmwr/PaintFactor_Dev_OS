{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "materials.schema.json",
  "title": "PaintFactor Materials Schema",
  "type": "object",
  "required": [
    "spec_family_id",
    "version",
    "material_systems",
    "coverage_profiles",
    "consumables"
  ],
  "properties": {
    "spec_family_id": { "type": "string", "pattern": "^SF_[A-Z0-9_]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },

    "material_systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system_id", "name", "description", "applies_when", "products"],
        "properties": {
          "system_id": { "type": "string", "pattern": "^SYS_[A-Z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "applies_when": { "type": "object" },
          "products": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["product_role", "product_type", "coats_required"],
              "properties": {
                "product_role": {
                  "type": "string",
                  "enum": ["primer", "topcoat", "sealer", "clear", "stain", "specialty", "finish"]
                },
                "product_type": { "type": "string" },
                "example_products": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "object",
                        "required": ["brand", "name"],
                        "properties": {
                          "brand": { "type": "string" },
                          "name": { "type": "string" },
                          "series": { "type": ["string", "null"] }
                        },
                        "additionalProperties": true
                      }
                    ]
                  }
                },
                "sheen": {
                  "type": "string",
                  "enum": ["flat", "matte", "eggshell", "satin", "semi-gloss", "gloss", "varies", "satin_or_semi-gloss", "satin_semi-gloss_or_gloss"]
                },
                "coats_required": { "type": "integer", "minimum": 1 },
                "notes": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "compatibility_notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "coverage_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profile_id", "material_system"],
        "properties": {
          "profile_id": { "type": "string", "pattern": "^COV_[A-Z0-9_]+$" },
          "material_system": {
            "oneOf": [
              { "type": "string", "pattern": "^SYS_[A-Z0-9_]+$" },
              { "type": "array", "items": { "type": "string", "pattern": "^SYS_[A-Z0-9_]+$" } }
            ]
          },
          "coverage_lf_per_gallon": { "type": "number", "exclusiveMinimum": 0 },
          "surface_texture": {
            "oneOf": [
              { "type": "string", "enum": ["smooth", "orange_peel", "knockdown", "heavy_texture", "skip_trowel"] },
              { "type": "array", "items": { "type": "string", "enum": ["smooth", "orange_peel", "knockdown", "heavy_texture", "skip_trowel"] } }
            ]
          },
          "surface_condition": {
            "type": "array",
            "items": { "type": "string" }
          },
          "drywall_finish_level": {
            "type": "array",
            "items": { "type": "string", "enum": ["level_3", "level_4", "level_5"] }
          },
          "coverage_sf_per_gallon": { "type": "number", "exclusiveMinimum": 0 },
          "coverage_range_low": { "type": "number", "exclusiveMinimum": 0 },
          "coverage_range_high": { "type": "number", "exclusiveMinimum": 0 },
          "assumptions": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "consumables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumable_id", "name", "category", "unit"],
        "properties": {
          "consumable_id": { "type": "string", "pattern": "^CON_[A-Z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["applicator", "protection", "prep", "cleanup", "abrasive", "solvent", "tool", "consumable", "additive", "fill_material"]
          },
          "specification": { "type": "string" },
          "unit": {
            "type": "string",
            "enum": ["EA", "ROLL", "BOX", "SHEET", "GAL", "QT", "TUBE", "PINT"]
          },
          "yield_per_unit": { "type": "number", "exclusiveMinimum": 0 },
          "yield_uom": {
            "type": "string",
            "enum": ["SF", "LF", "EA", "SF_FLOOR", "LF_EDGE", "GAL", "EA_OPENING"]
          },
          "applies_when": { "type": "object" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "material_notes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true
}

    { "dimension_id": "coating_type", "description": "Stain-clear workflow", "values": ["stain_clear"], "default": "stain_clear" },
    { "dimension_id": "sheen", "description": "Topcoat sheen", "values": ["satin", "semi_gloss", "gloss"], "default": "satin" }

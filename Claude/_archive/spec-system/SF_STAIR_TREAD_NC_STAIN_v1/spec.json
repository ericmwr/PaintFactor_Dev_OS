    "name": "New Construction Stair Tread Stain",
    "description": "Sand, stain, seal, and topcoat wood stair treads (natural wood finish). Typical NC workflow for hardwood treads: stain → sanding sealer → 2 clear coats polyurethane. Paint is NOT supported (paint paths go through riser spec, not tread). Tread installation usually happens after riser paint + before skirtboard finish, so protection zones include masked risers + painted walls.",
    "domain": "interior",
    "version": "0.1.0",
    "status": "draft",
    "review_required": true
  },
  "components_covered": ["tread"],
  "scope_boundaries": {
    "includes": ["Stair treads (horizontal stepping surface)", "Natural wood stain + sealer + clear topcoat", "Tread nosings (integral to tread)"],
    "excludes": ["Painted treads (rare — if needed, extend riser spec)", "Landings (floor spec)", "Risers (separate spec)"]
  },
